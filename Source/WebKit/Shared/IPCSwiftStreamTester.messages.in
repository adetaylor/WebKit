#if ENABLE(IPC_TESTING_API) && ENABLE(IPC_TESTING_SWIFT)

[
    ExceptionForDispatchedFrom,
    ExceptionForDispatchedTo,
    ExceptionForEnabledBy,
    SwiftReceiver
]
messages -> IPCSwiftStreamTester Stream {
    Record(uint32_t value)
    TakeRecordedDigest() -> (uint32_t digest) Synchronous
    Add(uint32_t a, uint32_t b) -> (uint32_t sum)
    RecordTextSwift(String text) SwiftTypes
    RepeatTextSwift(String text, uint32_t count) -> (String repeated) Synchronous SwiftTypes
    TakeRecordedDigestSwift() -> (uint32_t digest) Synchronous SwiftTypes WantsConnection
    DigestVectorsSwift(Vector<uint16_t> shorts, Vector<uint32_t> words, Vector<int64_t> longs, Vector<double> doubles) -> (uint64_t digest) Synchronous SwiftTypes
    DigestLentBytesSwift(uint32_t salt, [Lent] std::span<const uint8_t> bytes, uint32_t tail) -> (uint32_t digest) Synchronous SwiftTypes
    AddSwift(uint32_t a, uint32_t b) -> (uint32_t sum) SwiftTypes ReplyCanDispatchOutOfOrder
    DeferAddSwift(uint32_t a, uint32_t b) -> (uint32_t sum) SwiftTypes ReplyCanDispatchOutOfOrder
    CompleteDeferredAddSwift(bool send) SwiftTypes

    BenchFourValues(uint32_t a, uint32_t b, uint32_t c, uint32_t d)
    BenchEmptySwift() SwiftTypes
    BenchFourValuesSwift(uint32_t a, uint32_t b, uint32_t c, uint32_t d) SwiftTypes
    BenchStringSwift(String text) SwiftTypes
    BenchVectorSwift(Vector<uint32_t> values) SwiftTypes
    BenchSyncSwift(uint64_t value) -> (uint64_t sameValue) Synchronous SwiftTypes
    [EnabledBy=AllowTestOnlyIPC] BenchEnabledFourValuesSwift(uint32_t a, uint32_t b, uint32_t c, uint32_t d) SwiftTypes
}

#endif
