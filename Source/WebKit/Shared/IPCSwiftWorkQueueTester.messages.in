#if ENABLE(IPC_TESTING_API) && ENABLE(IPC_TESTING_SWIFT)

[
    ExceptionForDispatchedFrom,
    ExceptionForDispatchedTo,
    ExceptionForEnabledBy,
    SwiftReceiver
]
messages -> IPCSwiftWorkQueueTester WorkQueue {
    Record(uint32_t value)
    TakeRecordedDigest() -> (uint32_t digest) Synchronous
    Add(uint32_t a, uint32_t b) -> (uint32_t sum)
    WasAlwaysDispatchedOnItsQueue() -> (bool onItsQueue) Synchronous
    RecordTextSwift(String text) SwiftTypes
    TakeRecordedTextsSwift() -> (uint32_t count, uint32_t utf8Length) Synchronous SwiftTypes
    AddSwift(uint32_t a, uint32_t b) -> (uint32_t sum) SwiftTypes
    DeferAddSwift(uint32_t a, uint32_t b) -> (uint32_t sum) SwiftTypes
    CompleteDeferredAddSwift(bool send) SwiftTypes
    HalveEvenNumberSwift(uint32_t value) -> (uint32_t half) SwiftTypes
    DigestBytesSwift(std::span<const uint8_t> bytes) -> (uint32_t count, uint32_t digest) Synchronous SwiftTypes

    BenchEmpty()
    BenchFourValues(uint32_t a, uint32_t b, uint32_t c, uint32_t d)
    BenchString(String text)
    BenchReply(uint64_t value) -> (uint64_t sameValue)
    BenchEmptySwift() SwiftTypes
    BenchFourValuesSwift(uint32_t a, uint32_t b, uint32_t c, uint32_t d) SwiftTypes
    BenchStringSwift(String text) SwiftTypes
    BenchVectorSwift(Vector<uint32_t> values) SwiftTypes
    BenchReplySwift(uint64_t value) -> (uint64_t sameValue) SwiftTypes
}

#endif
