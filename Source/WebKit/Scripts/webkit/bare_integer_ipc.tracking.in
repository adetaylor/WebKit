# Every bare integer that a less privileged process can send to a more privileged one is
# listed here with a reason it is not an object identifier.
#
# The rule is inverted deliberately. Whether an integer is an identifier depends on how
# the receiver uses it, which is not visible from the declaration, so the generator cannot
# detect identifiers: a name-based test both misses real ones (an object handle named
# "pageOverlay") and flags correct ones (displayID, logIdentifier, ANGLE object names).
# Requiring a reason for every integer means a violation cannot be a silent omission,
# only a false claim, and a false claim is something review can catch.
#
# Categories are defined in Source/WebKit/Scripts/webkit/bare_integer_ipc.py.
#
# Additions or changes to this file will trigger a review with a security focus.

# these ARE object identifiers and must become ObjectIdentifier<Tag>. Burn-down list; do not add to it without a bug number
[NeedsTyping] {
    AcceleratedBackingStore.DidCreateAndroidBuffer id
    AcceleratedBackingStore.DidCreateDMABufBuffer id
    AcceleratedBackingStore.DidCreateSHMBuffer id
    AcceleratedBackingStore.DidDestroyBuffer id
    AcceleratedBackingStore.Frame id
    AcceleratedSurface.ReleaseBuffer id
    RemoteObjectRegistry.CallReplyBlock replyID
    RemoteObjectRegistry.ReleaseUnusedReplyBlock replyID
}

# generation and epoch counters, compared against locally held state; legitimately zero, which ObjectIdentifier cannot represent
[SequenceCounter] {
    DrawingAreaProxy.DidFirstLayerFlush backingStoreStateID
    DrawingAreaProxy.EnterAcceleratedCompositingMode backingStoreStateID
    DrawingAreaProxy.ExitAcceleratedCompositingMode backingStoreStateID
    DrawingAreaProxy.Update stateID
    DrawingAreaProxy.UpdateAcceleratedCompositingMode backingStoreStateID
    NetworkStorageManager.CacheStorageAllCaches updateCounter
    NetworkStorageManager.ConnectToStorageArea messageIdentifier
    NetworkStorageManager.ConnectToStorageAreaSync messageIdentifier
    WebPageProxy.ExecuteUndoRedo undoVersion
    WebProcessProxy.WaitForSharedPreferencesForWebProcessToSync sharedPreferencesVersion
    WebSWServerToContextConnection.ReportConsoleMessage requestIdentifier
}

# assigned outside WebKit: CGDirectDisplayID, OS pids, NSPasteboard change counts, native window handles
[PlatformValue] {
    GPUConnectionToWebProcess.CreateWCLayerTreeHost nativeWindow
    WebPageProxy.BindRemoteAccessibilityFrames processIdentifier
    WebPasteboardProxy.AddPasteboardTypes changeCount
    WebPasteboardProxy.AllPasteboardItemInfo changeCount
    WebPasteboardProxy.GetPasteboardChangeCount changeCount
    WebPasteboardProxy.InformationForItemAtIndex changeCount
    WebPasteboardProxy.SetPasteboardBufferForType changeCount
    WebPasteboardProxy.SetPasteboardColor changeCount
    WebPasteboardProxy.SetPasteboardStringForType changeCount
    WebPasteboardProxy.SetPasteboardTypes changeCount
    WebPasteboardProxy.SetPasteboardURL changeCount
    WebPasteboardProxy.TestIPCSharedMemory changeCount
    WebPasteboardProxy.WriteCustomData changeCount
    WebPasteboardProxy.WriteWebArchiveToPasteBoard changeCount
    WebProcessProxy.SetDisplayLinkPreferredFramesPerSecond displayID
    WebProcessProxy.StartDisplayLink displayID
    WebProcessProxy.StopDisplayLink displayID
}

# opaque values used only for log correlation, never dereferenced
[LoggingCookie] {
    PlaybackSessionManagerProxy.SetLogIdentifier logIdentifier
    RemoteCDMInstanceProxy.CreateSession logIdentifier
    RemoteCDMInstanceSessionProxy.SetLogIdentifier logIdentifier
    RemoteCDMProxy.SetLogIdentifier logIdentifier
    RemoteLegacyCDMProxy.CreateSession logIdentifier
    RemoteSampleBufferDisplayLayer.SetLogIdentifier logIdentifier
    WebPageProxy.LogScrollingEvent data
}

# row identifiers assigned by SQLite
[DatabaseRowID] {
    NetworkStorageManager.DidGenerateIndexKeyForRecord recordID
}

# assigned by libwebrtc or CoreAudio; the wire format is not ours to choose
[ExternalLibrary] {
    LibWebRTCCodecsProxy.DecodeFrame timeStamp
    LibWebRTCCodecsProxy.EncodeFrame timeStamp
    LibWebRTCCodecsProxy.InitializeEncoder maxBitrate
    LibWebRTCCodecsProxy.InitializeEncoder maxFramerate
    LibWebRTCCodecsProxy.InitializeEncoder minBitrate
    LibWebRTCCodecsProxy.InitializeEncoder startBitrate
    NetworkRTCProvider.CreateUDPSocket maxPort
    NetworkRTCProvider.CreateUDPSocket minPort
    RemoteAudioDestinationManager.CreateAudioDestination audioUnitLatency
    RemoteAudioDestinationManager.StartAudioDestination audioUnitLatency
}

# error and status codes
[StatusCode] {
    NetworkSocketChannel.Close code
    NetworkTransportSession.CancelReceiveStream errorCode
    NetworkTransportSession.CancelSendStream errorCode
    NetworkTransportSession.DestroyStream errorCode
    NetworkTransportSession.Terminate code
    RemoteLegacyCDMSessionProxy.GenerateKeyRequest errorCode
    RemoteLegacyCDMSessionProxy.GenerateKeyRequest systemCode
    RemoteLegacyCDMSessionProxy.Update errorCode
    RemoteLegacyCDMSessionProxy.Update systemCode
}

# flags or enumerations that have not been given an enum type
[EnumLike] {
    NetworkRTCProvider.CreateClientTCPSocket options
    NetworkRTCProvider.SetSocketOption option
    NetworkStorageManager.RequestNewCapacityForSyncAccessHandle result
    VideoPresentationManagerProxy.ClearVideoFullscreenMode mode
    VideoPresentationManagerProxy.ExitFullscreenWithoutAnimationToMode videoFullscreenMode
    VideoPresentationManagerProxy.SetVideoFullscreenMode mode
    VideoPresentationManagerProxy.SetupFullscreenWithID videoFullscreenMode
    WebPageProxy.LogDiagnosticMessageWithResultFromWebProcess result
    WebPageProxy.LogScrollingEvent eventType
    WebPageProxy.RecommendedScrollbarStyleDidChange newStyle
    WebPageProxy.ShowPopupMenuFromFrame textDirection
    WebProcessPool.ReportWebContentCPUTime activityState
}

