# Every bare integer crossing IPC where a less privileged process could supply it is
# listed here with a reason it is not an object identifier - as a message parameter
# (MessageParam) or as a member of a serialized struct (StructMember).
#
# The rule is inverted deliberately. Whether an integer is an identifier depends on how
# the receiver uses it, which is not visible from the declaration, so the generator cannot
# detect identifiers: a name-based test both misses real ones (an object handle named
# "pageOverlay") and flags correct ones (displayID, logIdentifier, ANGLE object names).
# Requiring a reason for every integer means a violation cannot be a silent omission,
# only a false claim, and a false claim is something review can catch.
#
# A serialized member that is an identifier's own raw-value accessor (toUInt64() and
# friends) is exempt: that is how a typed identifier correctly reaches the wire.
#
# Categories are defined in Source/WebKit/Scripts/webkit/bare_integer_ipc.py.
#
# Additions or changes to this file will trigger a review with a security focus.

# these ARE object identifiers and must become ObjectIdentifier<Tag>. Burn-down list; do not add without a bug number
[NeedsTyping] {
    MessageParam AcceleratedBackingStore.DidCreateAndroidBuffer id
    MessageParam AcceleratedBackingStore.DidCreateDMABufBuffer id
    MessageParam AcceleratedBackingStore.DidCreateSHMBuffer id
    MessageParam AcceleratedBackingStore.DidDestroyBuffer id
    MessageParam AcceleratedBackingStore.Frame id
    MessageParam AcceleratedSurface.ReleaseBuffer id
    MessageParam RemoteObjectRegistry.CallReplyBlock replyID
    MessageParam RemoteObjectRegistry.ReleaseUnusedReplyBlock replyID
}

