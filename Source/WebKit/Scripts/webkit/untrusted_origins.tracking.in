# A privileged process cannot trust a web origin, site, registrable domain or URL that
# a web content process supplied over IPC. Under site isolation a web process only has
# authority over its own site, so an origin arriving from it must be proven to be one
# that process was entitled to name before the privileged process acts on it.
#
# The type system enforces this. A parameter declared as IPC::Untrusted<T> in a
# .messages.in file decodes to IPC::Untrusted<T>, so the receiving handler's signature
# must accept the wrapper, and the wrapper has no accessors. The only ways to reach the
# value are:
#
#   validate(validator)                 - runs one of the pre-ordained validation
#                                         procedures, which confirm the sending process
#                                         had authority over the origin or domain
#   extractWithoutValidation(reason)    - bypass, and must name a justification
#
# See Source/WebKit/Platform/IPC/Untrusted.h and
# Source/WebKit/Shared/UntrustedOriginValidation.h.
#
# This file lists the parameters that are NOT yet wrapped. Every entry is a code path
# where a privileged process takes a web-content-supplied origin or URL on trust. The
# build fails on any unlisted occurrence, so the list can only shrink.
#
# Additions or changes to this file will trigger a review with a security focus.

# Every entry carries one justification and one Consequence= (in square brackets).
#
# Justifications:
#   ValidatedElsewhere    An equivalent authority check already happens on this code path.
#   RequestTarget         The value names a resource the sender is asking about rather than
#                         authority the sender claims; access control is applied downstream,
#                         normally keyed on a sibling parameter that IS authority-checked.
#   NotSecuritySensitive  The value is not used to make a security decision.
#   NeedsReview           A malicious web content process can abuse this. The Consequence
#                         records what it achieves. These are the remaining real risks.
#
# Consequence= records what a malicious web content process achieves by naming an origin it
# has no authority over, whether or not the path is currently guarded:
#   CrossOriginRead   CrossOriginWrite   OriginSpoofing   PolicyCorruption
#   LocalResource     None
#
# Format, grouped by justification, consequence and type:
#
#   [Justification, Consequence=Class] TypeString {
#       # why
#       MessageParam Receiver.Message parameterName
#   }
#
# or one entry per line:
#
#   [Justification, Consequence=Class] MessageParam Receiver.Message parameterName TypeString

# ---------------------------------------------------------------------------
# UI process (51)
# ---------------------------------------------------------------------------

[NeedsReview, Consequence=CrossOriginRead] URL {
    # sent by an extension content script; host-permission scoping for this URL is not verified at the IPC boundary
    MessageParam WebExtensionContext.CookiesGet url
    MessageParam WebExtensionContext.CookiesGetAll url
    # no authority check; discloses another origin's displayed notifications
    MessageParam WebProcessProxy.GetNotifications registrationURL
}

[NeedsReview, Consequence=CrossOriginRead] WebCore::ClientOrigin {
    # unchecked; discloses permission state for an arbitrary origin
    MessageParam WebPermissionControllerProxy.Query origin
}

[NeedsReview, Consequence=CrossOriginRead] WebCore::SecurityOriginData {
    # unchecked; queries per-relying-party passkey capabilities via ASCWebKitSPISupport
    MessageParam WebAuthenticatorCoordinatorProxy.GetClientCapabilities origin
    # unchecked relying-party origin for a capability query
    MessageParam WebAuthenticatorCoordinatorProxy.IsUserVerifyingPlatformAuthenticatorAvailable origin
    MessageParam WebAuthenticatorCoordinatorProxy.isConditionalMediationAvailable origin
    # unchecked; the top-level origin used for device ID salting
    MessageParam WebPageProxy.EnumerateMediaDevicesForFrame topLevelDocumentOriginIdentifier
    # unchecked; device enumeration and per-origin device ID salting are keyed on this origin
    MessageParam WebPageProxy.EnumerateMediaDevicesForFrame userMediaDocumentOriginIdentifier
}

[NeedsReview, Consequence=CrossOriginRead] std::optional<WebCore::SecurityOriginData> {
    # unchecked; the targetOrigin filter the receiving frame applies
    MessageParam WebPageProxy.PostMessageToRemote targetOrigin
}

[NeedsReview, Consequence=CrossOriginWrite] URL {
    # sent by an extension content script; host-permission scoping for this URL is not verified at the IPC boundary
    MessageParam WebExtensionContext.CookiesRemove url
}

[NeedsReview, Consequence=CrossOriginWrite] WebCore::RegistrableDomain {
    # no check; changes the accuracy mode recorded for an arbitrary domain
    MessageParam WebGeolocationManagerProxy.SetEnableHighAccuracy registrableDomain
    # no check; stops geolocation updates for an arbitrary domain
    MessageParam WebGeolocationManagerProxy.StopUpdating registrableDomain
}

[NeedsReview, Consequence=CrossOriginWrite] WebCore::SecurityOriginData {
    # unchecked relying-party origin; rewrites another origin's accepted-credential set
    MessageParam WebAuthenticatorCoordinatorProxy.SignalAllAcceptedCredentials origin
    # unchecked relying-party origin; rewrites another origin's stored user details
    MessageParam WebAuthenticatorCoordinatorProxy.SignalCurrentUserDetails origin
    # unchecked relying-party origin; signals a credential is unknown, which can remove another origin's passkey metadata
    MessageParam WebAuthenticatorCoordinatorProxy.SignalUnknownCredential origin
}

[NeedsReview, Consequence=OriginSpoofing] URL {
    # only file-URL access is checked; document.open() must not change the frame's origin
    MessageParam WebPageProxy.DidExplicitOpenForFrame url
    # only file-URL access is checked; a same-document navigation must stay same-origin with the frame's current URL, which is not enforced, so the committed URL and hence the URL bar can be set cross-origin
    MessageParam WebPageProxy.DidSameDocumentNavigationForFrame url
    # the frame is checked to belong to the sending process and file-URL access is checked, but same-origin with the frame's current URL is not
    MessageParam WebPageProxy.DidSameDocumentNavigationForFrameViaJS url
    # unchecked; the merchant origin for an Apple Pay session UI
    MessageParam WebPageProxy.StartApplePayAMSUISession originatingURL
    # unchecked; surfaced to the injected bundle and navigation client as the form target
    MessageParam WebPageProxy.WillSubmitForm requestURL
    # unchecked; names an inspector target after an arbitrary origin
    MessageParam WebProcessProxy.CreateServiceWorkerDebuggable url
}

[NeedsReview, Consequence=OriginSpoofing] WebCore::ClientOrigin {
    # unchecked; the origin shown in the microphone permission prompt for speech recognition
    MessageParam SpeechRecognitionServer.Start origin
    # unchecked; the origin shown in and recorded for the DRM key-system permission decision
    MessageParam WebPageProxy.RequestMediaKeySystemPermissionForFrame clientOrigin
    # unchecked; drives the capture-state indicator and permission attribution
    MessageParam WebPageProxy.ValidateCaptureStateUpdate clientOrigin
}

[NeedsReview, Consequence=OriginSpoofing] WebCore::SecurityOriginData {
    # unchecked; the origin shown in the immersive-session permission prompt
    MessageParam PlatformXRSystem.RequestPermissionOnSessionFeatures origin
    # unchecked; the origin attributed to the system preview
    MessageParam WebPageProxy.BeginSystemPreview topOrigin
    # unchecked and forwarded to another process as the origin performing the navigation, which decides whether beforeunload is treated as cross-origin
    MessageParam WebPageProxy.DispatchCrossOriginBeforeUnloadCheckForFrame navigatingFrameOrigin
    # unchecked and forwarded verbatim to the target frame's process, where it becomes MessageEvent.origin; this forges the origin check that cross-origin messaging under site isolation depends on
    MessageParam WebPageProxy.PostMessageToRemote sourceOrigin
    # unchecked; the top-level origin shown in the capture permission prompt
    MessageParam WebPageProxy.RequestUserMediaPermissionForFrame topLevelDocumentOriginIdentifier
    # unchecked; this is the origin shown in the camera and microphone permission prompt and recorded in the granted-permission state
    MessageParam WebPageProxy.RequestUserMediaPermissionForFrame userMediaDocumentOriginIdentifier
}

[NeedsReview, Consequence=OriginSpoofing] std::optional<URL> {
    # unchecked; selects which frame a devtools extension evaluates script in
    MessageParam WebExtensionContext.DevToolsInspectedWindowEval frameURL
}

[NeedsReview, Consequence=PolicyCorruption] HashSet<WebCore::SecurityOriginData> {
    # unchecked set of origins written into UI-process CSP upgrade state for the frame
    MessageParam WebFrameProxy.DidChangeCSPOriginsThatUpgradeInsecureNavigations cspOriginsThatUpgradeInsecureNavigations
    # unchecked set of origins written into UI-process CSP upgrade state
    MessageParam WebPageProxy.DidCommitLoadForFrame cspOriginsThatUpgradeInsecureNavigations
}

[NotSecuritySensitive, Consequence=None] URL {
    # Web Inspector proxying agent; the value is relayed to the inspector frontend
    MessageParam ProxyingPageAgent.FrameNavigated url
    # sent by the Web Inspector UI process, relayed to inspector extensions
    MessageParam WebInspectorUIExtensionControllerProxy.DidNavigateExtensionTab newURL
    MessageParam WebInspectorUIExtensionControllerProxy.InspectedPageDidNavigate newURL
    # descriptive URL recorded in the media usage session
    MessageParam WebPageProxy.AddMediaUsageManagerSession pageURL
    # passed to the navigation client as a content-blocking notification; no privileged decision
    MessageParam WebPageProxy.ContentRuleListNotification url
    # reported to the navigation client for telemetry
    MessageParam WebPageProxy.DidApplyLinkDecorationFiltering adjustedURL
    MessageParam WebPageProxy.DidApplyLinkDecorationFiltering originalURL
    # interpolated into a console warning only
    MessageParam WebPageProxy.ReportMixedContentViolation target
}

[NotSecuritySensitive, Consequence=None] WebCore::SecurityOriginData {
    # Web Inspector proxying agent; the value is relayed to the inspector frontend
    MessageParam ProxyingPageAgent.FrameNavigated securityOrigin
    # WebDriver automation session bookkeeping, only reachable when automation is enabled
    MessageParam WebAutomationSession.ScriptRealmCreated origin
}

[RequestTarget, Consequence=None] URL {
    # the item to preview; travels with its own sandbox extension
    MessageParam WebPageProxy.BeginSystemPreview url
    # identifies the image being recognised; the bitmap travels alongside it
    MessageParam WebPageProxy.RequestTextRecognition imageURL
}

[ValidatedElsewhere, Consequence=OriginSpoofing] URL {
    # MESSAGE_CHECK_URL covers file-URL sandbox access; a provisional navigation target is legitimately not the sending process's own origin, and the URL only becomes authoritative at commit; the frame is also checked to be in Provisional state
    MessageParam WebPageProxy.DidChangeProvisionalURLForFrame url
    # MESSAGE_CHECK_URL covers file-URL sandbox access; a provisional navigation target is legitimately not the sending process's own origin, and the URL only becomes authoritative at commit
    MessageParam WebPageProxy.DidStartProvisionalLoadForFrame unreachableURL
    MessageParam WebPageProxy.DidStartProvisionalLoadForFrame url
}

[ValidatedElsewhere, Consequence=OriginSpoofing] WebCore::RegistrableDomain {
    # the domain must match the one bound to the authorization token issued by the page's geolocation permission manager
    MessageParam WebGeolocationManagerProxy.StartUpdating registrableDomain
}

[ValidatedElsewhere, Consequence=OriginSpoofing] std::optional<WebCore::SecurityOriginData> {
    # checked against the frame's ancestor chain in the UI process, and frameInfo.securityOrigin is checked against the frame's URL
    MessageParam WebAuthenticatorCoordinatorProxy.GetAssertion parentOrigin
}

# ---------------------------------------------------------------------------
# Networking process (102)
# ---------------------------------------------------------------------------

[NeedsReview, Consequence=CrossOriginRead] URL {
    # no origin check: the blob URL embeds its owning origin and topOrigin is the partition key, but neither is validated, and BlobRegistryImpl::registerBlobURLOptionallyFileBacked() resolves srcURL with no topOrigin so the partition check is bypassed on the aliasing path
    MessageParam NetworkConnectionToWebProcess.BlobSize url
    MessageParam NetworkConnectionToWebProcess.BlobType url
    # no authority check; discloses another origin's push permission state
    MessageParam NetworkConnectionToWebProcess.NavigatorGetPushPermissionState scopeURL
    # no authority check; discloses another origin's push subscription including its endpoint and keys
    MessageParam NetworkConnectionToWebProcess.NavigatorGetPushSubscription scopeURL
    # no origin check: the blob URL embeds its owning origin and topOrigin is the partition key, but neither is validated, and BlobRegistryImpl::registerBlobURLOptionallyFileBacked() resolves srcURL with no topOrigin so the partition check is bypassed on the aliasing path; naming another origin's blob as srcURL clones its contents into a URL the sender controls
    MessageParam NetworkConnectionToWebProcess.RegisterBlobURL srcURL
    # no authority check; discloses another origin's displayed notifications
    MessageParam WebSWServerConnection.GetNotifications registrationURL
}

[NeedsReview, Consequence=CrossOriginRead] WebCore::ClientOrigin {
    # isValidClientOrigin() only rejects null origins; registering on another origin's channel receives its BroadcastChannel messages
    MessageParam NetworkBroadcastChannelRegistry.RegisterChannel origin
    # isSiteAllowedForConnection() authority-checks origin.topOrigin, but origin.clientOrigin - which is the storage partition key and part of the on-disk path - is never checked, so a process authorised for a top origin can reach any client origin partitioned under it
    MessageParam NetworkStorageManager.CacheStorageAllCaches origin
    MessageParam NetworkStorageManager.Estimate origin
    MessageParam NetworkStorageManager.GetAllDatabaseNamesAndVersions origin
    MessageParam NetworkStorageManager.Persisted origin
    MessageParam NetworkStorageManager.ResolveGlobalIdentifier origin
}

[NeedsReview, Consequence=CrossOriginRead] WebCore::RegistrableDomain {
    # neither domain is authority-checked, unlike the sibling RequestStorageAccessUnderOpener which does check; the pair is a cross-site tracking oracle and RequestStorageAccess additionally prompts the user naming both domains and can grant third-party cookie access
    MessageParam NetworkConnectionToWebProcess.HasStorageAccess subFrameDomain
    MessageParam NetworkConnectionToWebProcess.HasStorageAccess topFrameDomain
    # no authority check; discloses login status for an arbitrary domain
    MessageParam NetworkConnectionToWebProcess.IsLoggedIn domain
    MessageParam NetworkConnectionToWebProcess.QueryStorageAccessPermission subFrameDomain
    MessageParam NetworkConnectionToWebProcess.QueryStorageAccessPermission topFrameDomain
    MessageParam NetworkConnectionToWebProcess.SubscribeToStorageAccessPermissionChanges subFrameDomain
    MessageParam NetworkConnectionToWebProcess.SubscribeToStorageAccessPermissionChanges topFrameDomain
    MessageParam NetworkConnectionToWebProcess.UnsubscribeFromStorageAccessPermissionChanges subFrameDomain
    MessageParam NetworkConnectionToWebProcess.UnsubscribeFromStorageAccessPermissionChanges topFrameDomain
}

[NeedsReview, Consequence=CrossOriginRead] std::optional<WebCore::SecurityOriginData> {
    # firstPartyForCookies is authority-checked but topOrigin, the blob partition key, is not
    MessageParam NetworkConnectionToWebProcess.ConvertMainResourceLoadToDownload topOrigin
    MessageParam NetworkConnectionToWebProcess.StartDownload topOrigin
}

[NeedsReview, Consequence=CrossOriginWrite] URL {
    # no authority check; creates a push subscription for an arbitrary service worker scope
    MessageParam NetworkConnectionToWebProcess.NavigatorSubscribeToPushService scopeURL
    # no authority check; removes another origin's push subscription
    MessageParam NetworkConnectionToWebProcess.NavigatorUnsubscribeFromPushService scopeURL
    # no origin check: the blob URL embeds its owning origin and topOrigin is the partition key, but neither is validated, and BlobRegistryImpl::registerBlobURLOptionallyFileBacked() resolves srcURL with no topOrigin so the partition check is bypassed on the aliasing path
    MessageParam NetworkConnectionToWebProcess.RegisterBlobURL url
    MessageParam NetworkConnectionToWebProcess.RegisterBlobURLHandle url
    MessageParam NetworkConnectionToWebProcess.RegisterInternalBlobURL url
    MessageParam NetworkConnectionToWebProcess.RegisterInternalBlobURLForSlice srcURL
    MessageParam NetworkConnectionToWebProcess.RegisterInternalBlobURLForSlice url
    MessageParam NetworkConnectionToWebProcess.RegisterInternalBlobURLOptionallyFileBacked srcURL
    MessageParam NetworkConnectionToWebProcess.RegisterInternalBlobURLOptionallyFileBacked url
    MessageParam NetworkConnectionToWebProcess.RegisterInternalFileBlobURL url
    MessageParam NetworkConnectionToWebProcess.UnregisterBlobURL url
    MessageParam NetworkConnectionToWebProcess.UnregisterBlobURLHandle url
    # unchecked; writes a script resource into another origin's service worker registration
    MessageParam WebSWServerToContextConnection.SetScriptResource scriptURL
}

[NeedsReview, Consequence=CrossOriginWrite] WebCore::ClientOrigin {
    # isValidClientOrigin() only rejects null origins; injects BroadcastChannel messages into another origin
    MessageParam NetworkBroadcastChannelRegistry.PostMessage origin
    # isValidClientOrigin() only rejects null origins; unregisters channels for an arbitrary origin
    MessageParam NetworkBroadcastChannelRegistry.UnregisterChannel origin
    # isSiteAllowedForConnection() authority-checks origin.topOrigin, but origin.clientOrigin - which is the storage partition key and part of the on-disk path - is never checked, so a process authorised for a top origin can reach any client origin partitioned under it
    MessageParam NetworkStorageManager.AddGlobalIdentifierReference origin
    MessageParam NetworkStorageManager.CacheStorageClearMemoryRepresentation origin
    MessageParam NetworkStorageManager.CacheStorageOpenCache origin
    MessageParam NetworkStorageManager.CancelConnectToStorageArea origin
    MessageParam NetworkStorageManager.ConnectToStorageArea origin
    MessageParam NetworkStorageManager.ConnectToStorageAreaSync origin
    MessageParam NetworkStorageManager.FileSystemGetDirectory origin
    MessageParam NetworkStorageManager.LockCacheStorage origin
    MessageParam NetworkStorageManager.Persist origin
    MessageParam NetworkStorageManager.RemoveGlobalIdentifierReferences origin
    MessageParam NetworkStorageManager.UnlockCacheStorage origin
    # checkTopOrigin() checks clientOrigin.topOrigin only; clientOrigin.clientOrigin registers the client identity a service worker sees and is unchecked
    MessageParam WebSWServerConnection.RegisterServiceWorkerClient clientOrigin
}

[NeedsReview, Consequence=CrossOriginWrite] std::optional<WebCore::SecurityOriginData> {
    # no origin check: the blob URL embeds its owning origin and topOrigin is the partition key, but neither is validated, and BlobRegistryImpl::registerBlobURLOptionallyFileBacked() resolves srcURL with no topOrigin so the partition check is bypassed on the aliasing path
    MessageParam NetworkConnectionToWebProcess.RegisterBlobURL topOrigin
    MessageParam NetworkConnectionToWebProcess.RegisterBlobURLHandle topOrigin
    MessageParam NetworkConnectionToWebProcess.UnregisterBlobURL topOrigin
    MessageParam NetworkConnectionToWebProcess.UnregisterBlobURLHandle topOrigin
}

[NeedsReview, Consequence=OriginSpoofing] URL {
    # sent by a service worker process; unchecked navigation target for an existing client
    MessageParam WebSWServerToContextConnection.Navigate url
    # sent by a service worker process; unchecked URL opened in a new window
    MessageParam WebSWServerToContextConnection.OpenWindow url
}

[NeedsReview, Consequence=OriginSpoofing] WebCore::RegistrableDomain {
    # neither domain is authority-checked, unlike the sibling RequestStorageAccessUnderOpener which does check; the pair is a cross-site tracking oracle and RequestStorageAccess additionally prompts the user naming both domains and can grant third-party cookie access
    MessageParam NetworkConnectionToWebProcess.RequestStorageAccess subFrameDomain
    MessageParam NetworkConnectionToWebProcess.RequestStorageAccess topFrameDomain
}

[NeedsReview, Consequence=OriginSpoofing] WebCore::SecurityOriginData {
    # unchecked and delivered to the client as MessageEvent.origin, forging the origin of a service worker message
    MessageParam WebSWServerToContextConnection.PostMessageToServiceWorkerClient sourceOrigin
}

[NeedsReview, Consequence=PolicyCorruption] WebCore::ClientOrigin {
    # firstPartyForCookies is checked only against Terminate; clientOrigin drives per-origin WebSocket bookkeeping and is unchecked
    MessageParam NetworkConnectionToWebProcess.CreateSocketChannel clientOrigin
    # unchecked; attributes the transport session to an arbitrary origin
    MessageParam NetworkConnectionToWebProcess.InitializeWebTransportSession clientOrigin
}

[NeedsReview, Consequence=PolicyCorruption] WebCore::RegistrableDomain {
    # domainInNeedOfStorageAccess is authority-checked; openerDomain is not, so the grant can be attributed to an arbitrary opener
    MessageParam NetworkConnectionToWebProcess.RequestStorageAccessUnderOpener openerDomain
    # no authority check; sets tracking-prevention login status for an arbitrary domain
    MessageParam NetworkConnectionToWebProcess.SetLoginStatus domain
    # unchecked; attributes the socket to a domain for proxy and tracking-prevention decisions
    MessageParam NetworkRTCProvider.CreateClientTCPSocket domain
    MessageParam NetworkRTCProvider.CreateUDPSocket domain
    # unchecked; selects the network interface policy applied to a domain
    MessageParam NetworkRTCProvider.GetInterfaceName domain
}

[NotSecuritySensitive, Consequence=None] WebCore::ClientOrigin {
    # testing-only entry point
    MessageParam NetworkStorageManager.ResetQuotaUpdatedBasedOnUsageForTesting origin
}

[RequestTarget, Consequence=CrossOriginRead] URL {
    # resource URL whose cookies are being asked about, not authority the sender claims; access is decided by the cookie store keyed on the authority-checked firstParty
    MessageParam NetworkConnectionToWebProcess.CookieRequestHeaderFieldValue url
    MessageParam NetworkConnectionToWebProcess.CookiesEnabled url
    MessageParam NetworkConnectionToWebProcess.CookiesEnabledSync url
    MessageParam NetworkConnectionToWebProcess.CookiesForDOM url
    MessageParam NetworkConnectionToWebProcess.CookiesForDOMAsync url
    MessageParam NetworkConnectionToWebProcess.DeleteCookie url
    MessageParam NetworkConnectionToWebProcess.GetRawCookies url
    MessageParam NetworkConnectionToWebProcess.SetCookieFromDOMAsync url
    MessageParam NetworkConnectionToWebProcess.SetCookiesFromDOM url
    MessageParam NetworkConnectionToWebProcess.SetRawCookie url
    MessageParam NetworkConnectionToWebProcess.SubscribeToCookieChangeNotifications url
}

[RequestTarget, Consequence=None] URL {
    # connection target, validated for scheme, port and IP-literal policy
    MessageParam NetworkConnectionToWebProcess.InitializeWebTransportSession url
    # preconnect ping target; a web process can already issue arbitrary requests
    MessageParam NetworkConnectionToWebProcess.SendH2Ping url
    # lookup key into a static compiled-in quirk list
    MessageParam NetworkConnectionToWebProcess.StorageAccessQuirkForTopFrameDomain topFrameURL
    # lookup target, restricted to the HTTP family
    MessageParam NetworkRTCProvider.GetInterfaceName url
    # registration lookup key, scoped by the authority-checked topOrigin
    MessageParam WebSWServerConnection.GetRegistrations clientURL
    MessageParam WebSWServerConnection.MatchRegistration clientURL
    MessageParam WebSWServerConnection.WhenRegistrationReady clientURL
}

[ValidatedElsewhere, Consequence=CrossOriginRead] URL {
    # validateCookieAccess() authority-checks firstParty via NetworkProcess::allowsFirstPartyForCookies() before any cookie is touched
    MessageParam NetworkConnectionToWebProcess.CookieRequestHeaderFieldValue firstParty
    MessageParam NetworkConnectionToWebProcess.CookiesEnabled firstParty
    MessageParam NetworkConnectionToWebProcess.CookiesEnabledSync firstParty
    MessageParam NetworkConnectionToWebProcess.CookiesForDOM firstParty
    MessageParam NetworkConnectionToWebProcess.CookiesForDOMAsync firstParty
    MessageParam NetworkConnectionToWebProcess.DeleteCookie firstParty
    # passed as both firstParty and url to validateCookieAccess()
    MessageParam NetworkConnectionToWebProcess.DomCookiesForHost host
    MessageParam NetworkConnectionToWebProcess.GetRawCookies firstParty
    MessageParam NetworkConnectionToWebProcess.SetCookieFromDOMAsync firstParty
    MessageParam NetworkConnectionToWebProcess.SetCookiesFromDOM firstParty
    MessageParam NetworkConnectionToWebProcess.SetRawCookie firstParty
    MessageParam NetworkConnectionToWebProcess.SubscribeToCookieChangeNotifications firstParty
}

[ValidatedElsewhere, Consequence=CrossOriginRead] WebCore::SecurityOriginData {
    # checkTopOrigin() authority-checks the top origin
    MessageParam WebSWServerConnection.GetRegistrations topOrigin
    # WebSWServerConnection::checkTopOrigin() authority-checks the top origin
    MessageParam WebSWServerConnection.MatchRegistration topOrigin
    MessageParam WebSWServerConnection.WhenRegistrationReady topOrigin
}

[ValidatedElsewhere, Consequence=PolicyCorruption] WebCore::Site {
    # allowsFirstPartyForCookies() rejects Terminate and SWServer::hasPendingConnectionDomain() requires a pending registration for the site
    MessageParam NetworkConnectionToWebProcess.EstablishSWContextConnection site
    # allowsFirstPartyForCookies() rejects Terminate before the context connection is created
    MessageParam NetworkConnectionToWebProcess.EstablishSharedWorkerContextConnection site
}

# ---------------------------------------------------------------------------
# GPU process (3)
# ---------------------------------------------------------------------------

[NeedsReview, Consequence=CrossOriginRead] WebCore::SecurityOriginData {
    # unchecked; the GPU process answers a cross-origin taint question for an arbitrary origin, which governs whether media pixels may be read back
    MessageParam RemoteMediaPlayerProxy.IsCrossOrigin origin
}

[NotSecuritySensitive, Consequence=None] URL {
    # recorded as a PDF link annotation rectangle
    MessageParam RemoteGraphicsContext.SetURLForRect link
}

[RequestTarget, Consequence=None] URL {
    # media load target; travels with its own sandbox extension where needed
    MessageParam RemoteMediaPlayerProxy.Load url
}

# ----------------------------------------------------------------------------
# ProcessQualified identifiers sent from web content to a privileged process.
# The object part of one of these is a per-process counter starting at 1, so an
# identifier valid in one web content process is guessable from another. Validating
# means proving the sender minted it: see Shared/ProcessProvenanceAuthority.h.
# ----------------------------------------------------------------------------

[ValidatedElsewhere, Consequence=CrossProcessObjectAccess] WebCore::RTCDataChannelIdentifier {
    # handler already MESSAGE_CHECKs provenance, or keys on per-connection state
    MessageParam NetworkConnectionToWebProcess.ConnectToRTCDataChannelRemoteSource handler
    MessageParam NetworkConnectionToWebProcess.ConnectToRTCDataChannelRemoteSource source
    MessageParam RTCDataChannelRemoteManagerProxy.BufferedAmountIsDecreasing handler
    MessageParam RTCDataChannelRemoteManagerProxy.ChangeReadyState handler
    MessageParam RTCDataChannelRemoteManagerProxy.Close source
    MessageParam RTCDataChannelRemoteManagerProxy.DetectError handler
    MessageParam RTCDataChannelRemoteManagerProxy.ReceiveData handler
    MessageParam RTCDataChannelRemoteManagerProxy.SendData source
}

[ValidatedElsewhere, Consequence=CrossProcessObjectAccess] WebCore::ScriptExecutionContextIdentifier {
    # handler already MESSAGE_CHECKs provenance, or keys on per-connection state
    MessageParam WebLockRegistryProxy.AbortLockRequest clientID
    MessageParam WebLockRegistryProxy.ClientIsGoingAway clientId
    MessageParam WebLockRegistryProxy.ReleaseLock clientID
    MessageParam WebLockRegistryProxy.RequestLock clientID
    MessageParam WebSWServerConnection.UnregisterServiceWorkerClient identifier
    MessageParam WebSWServerToContextConnection.Focus serviceWorkerClientIdentifier
    MessageParam WebSWServerToContextConnection.PostMessageToServiceWorkerClient destination
}

[ValidatedElsewhere, Consequence=CrossProcessObjectAccess] WebCore::SharedWorkerObjectIdentifier {
    # handler already MESSAGE_CHECKs provenance, or keys on per-connection state
    MessageParam WebSharedWorkerServerConnection.RequestSharedWorker sharedWorkerObjectIdentifier
    MessageParam WebSharedWorkerServerConnection.ResumeForBackForwardCache sharedWorkerObjectIdentifier
    MessageParam WebSharedWorkerServerConnection.SharedWorkerObjectIsGoingAway sharedWorkerObjectIdentifier
    MessageParam WebSharedWorkerServerConnection.SuspendForBackForwardCache sharedWorkerObjectIdentifier
}

[ValidatedElsewhere, Consequence=CrossProcessObjectAccess] WebCore::WebLockIdentifier {
    # handler already MESSAGE_CHECKs provenance, or keys on per-connection state
    MessageParam WebLockRegistryProxy.AbortLockRequest identifier
    MessageParam WebLockRegistryProxy.ReleaseLock identifier
    MessageParam WebLockRegistryProxy.RequestLock identifier
}

[ValidatedElsewhere, Consequence=CrossProcessObjectAccess] WebKit::TransactionID {
    # handler already MESSAGE_CHECKs provenance, or keys on per-connection state
    MessageParam RemoteLayerTreeDrawingAreaProxy.NotifyFlushingLayerTree transactionID
}

[ValidatedElsewhere, Consequence=CrossProcessObjectAccess] std::optional<WebCore::ScriptExecutionContextIdentifier> {
    # handler already MESSAGE_CHECKs provenance, or keys on per-connection state
    MessageParam NetworkConnectionToWebProcess.EstablishSWContextConnection serviceWorkerPageIdentifier
}

[ValidatedElsewhere, Consequence=CrossProcessObjectAccess] std::optional<WebKit::TransactionID> {
    # handler already MESSAGE_CHECKs provenance, or keys on per-connection state
    MessageParam RemoteLayerTreeDrawingAreaProxy.NotifyPendingCommitLayerTree transactionID
}

[ValidatedElsewhere, Consequence=CrossProcessObjectAccess] WebCore::ScriptExecutionContextIdentifier {
    # authorised by ownership: the client must belong to this worker. A provenance check would be wrong, as a service worker legitimately controls clients in other processes
    MessageParam WebSWServerToContextConnection.Navigate clientIdentifier
}

[RequestTarget, Consequence=CrossProcessObjectAccess] WebCore::DOMCacheIdentifier {
    # resolved in a session-wide registry, then the resolved cache's origin is checked against the connection
    MessageParam NetworkStorageManager.CacheStorageDereference cacheIdentifier
    MessageParam NetworkStorageManager.CacheStoragePutRecords cacheIdentifier
    MessageParam NetworkStorageManager.CacheStorageReference cacheIdentifier
    MessageParam NetworkStorageManager.CacheStorageRemoveCache cacheIdentifier
    MessageParam NetworkStorageManager.CacheStorageRemoveRecords cacheIdentifier
    MessageParam NetworkStorageManager.CacheStorageRetrieveRecords cacheIdentifier
}

