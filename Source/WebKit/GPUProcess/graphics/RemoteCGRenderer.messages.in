#if ENABLE(GPU_PROCESS) && ENABLE(GPU_PROCESS_CG_RENDERER_SWIFT)

# The RemoteGraphicsContext messages that an image buffer's context takes in Swift, drawing with its Swift CG renderer
# directly (RemoteCGRenderer.swift), which RemoteImageBufferGraphicsContext lends each handler. They share the stream and
# the destination with the image buffer's RemoteGraphicsContext, which takes the rest, so they stay in order with them.
# The renderer declines some draws, which go back to RemoteImageBufferGraphicsContext.
# They are RemoteGraphicsContext's definitions, apart from the packed colors, which their handlers take as uint32_t, the line
# strokes and line dashes, which the GPU process copies out of the message, paths and their segments, which it decodes into
# plain values or the PathImpl of a path of them, and shadows and styles, which it keeps for Swift to ask of them.
[
    ExceptionForEnabledBy,
    DispatchedFrom=WebContent,
    DispatchedTo=GPU,
    SwiftReceiver,
    SwiftReceiverStateLender=WebKit::RemoteImageBufferGraphicsContext,
    MessagesFrom=RemoteGraphicsContext
]
messages -> RemoteCGRenderer Stream {
    Save
    Restore SwiftMayDecline
    Translate
    Rotate
    Scale
    SetCTM
    ConcatCTM
    SetFillPackedColor(uint32_t color) StreamBatched
    SetStrokePackedColor(uint32_t color) StreamBatched
    SetStrokePackedColorAndThickness(uint32_t color, float thickness) StreamBatched
    SetFillRule
    SetStrokeThickness
    SetStrokeStyle
    SetCompositeMode
    SetAlpha
    SetImageInterpolationQuality
    SetShouldAntialias
    SetShouldSmoothFonts
    SetShouldSubpixelQuantizeFonts
    SetLineCap
    SetLineJoin
    SetMiterLimit
    Clip
    ClipOut
    ResetClip
    DrawLine
    FillRect SwiftMayDecline
    FillEllipse SwiftMayDecline
    StrokeRect SwiftMayDecline
    StrokeEllipse SwiftMayDecline
    ClearRect
    ApplyStrokePattern
    ApplyFillPattern
    DrawRect
    DrawEllipse SwiftMayDecline
    FillLine SwiftMayDecline
    FillArc SwiftMayDecline
    FillClosedArc SwiftMayDecline
    FillQuadCurve SwiftMayDecline
    FillBezierCurve SwiftMayDecline
    FillPathSegment(WebKit::RemoteCGRendererPathSegment segment) StreamBatched SwiftMayDecline
    StrokeLine SwiftMayDecline
    StrokeLinesWithColorAndThickness(WebKit::RemoteCGRendererLineStrokes lines) StreamBatched
    StrokeArc SwiftMayDecline
    StrokeClosedArc SwiftMayDecline
    StrokeQuadCurve SwiftMayDecline
    StrokeBezierCurve SwiftMayDecline
    StrokePathSegment(WebKit::RemoteCGRendererPathSegment segment) StreamBatched SwiftMayDecline
    FillPath(WebKit::RemoteCGRendererPath path) StreamBatched SwiftMayDecline
    StrokePath(WebKit::RemoteCGRendererPath path) StreamBatched SwiftMayDecline
    DrawPath(WebKit::RemoteCGRendererPath path) StreamBatched SwiftMayDecline
    ClipPath(WebKit::RemoteCGRendererPath path, enum:bool WebCore::WindRule windRule) StreamBatched
    ClipOutToPath(WebKit::RemoteCGRendererPath path) StreamBatched
    FillCachedPath SwiftMayDecline
    ClipCachedPath
    DrawNativeImage SwiftMayDecline
    DrawImageBuffer SwiftMayDecline
    DrawPatternNativeImage
    DrawPatternImageBuffer SwiftMayDecline
    SetFillColor
    SetStrokeColor
    SetDropShadow(WebKit::RemoteCGRendererShadow dropShadow) StreamBatched
    SetStyle(WebKit::RemoteCGRendererStyle style) StreamBatched SwiftMayDecline
    SetTextDrawingMode
    SetShadowsIgnoreTransforms
    SetLineDash(WebKit::RemoteCGRendererLineDash dashArray, float dashOffset) StreamBatched
    FillRectWithColor SwiftMayDecline
    FillCompositedRect SwiftMayDecline
    ApplyDeviceScaleFactor
    ClipRoundedRect
    ClipOutRoundedRect
    ClipToNativeImage SwiftMayDecline
}

#endif
