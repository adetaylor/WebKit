header: <WebCore/PathSegmentData.h>
[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathMoveTo {
    WebCore::FloatPoint point;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathLineTo {
    WebCore::FloatPoint point;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathQuadCurveTo {
    WebCore::FloatPoint controlPoint;
    WebCore::FloatPoint endPoint;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathBezierCurveTo {
    WebCore::FloatPoint controlPoint1;
    WebCore::FloatPoint controlPoint2;
    WebCore::FloatPoint endPoint;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathArcTo {
    WebCore::FloatPoint controlPoint1;
    WebCore::FloatPoint controlPoint2;
    float radius;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathArc {
    WebCore::FloatPoint center;
    float radius;
    float startAngle;
    float endAngle;
    WebCore::RotationDirection direction;
};

[AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathArcColorThickness {
    WebCore::FloatPoint center;
    float radius;
    float startAngle;
    float endAngle;
    WebCore::PackedColor::RGBA color;
    float thickness;
    uint32_t isClockwise;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathClosedArc {
    WebCore::PathArc arc;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathEllipse {
    WebCore::FloatPoint center;
    float radiusX;
    float radiusY;
    float rotation;
    float startAngle;
    float endAngle;
    WebCore::RotationDirection direction;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathEllipseInRect {
    WebCore::FloatRect rect;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathRect {
    WebCore::FloatRect rect;
};

[Nested, Swift] enum class WebCore::PathRoundedRect::Strategy : uint8_t {
    PreferNative,
    PreferBezier
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathRoundedRect {
    WebCore::FloatRoundedRect roundedRect;
    WebCore::PathRoundedRect::Strategy strategy;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathContinuousRoundedRect {
    WebCore::FloatRect rect;
    float cornerWidth;
    float cornerHeight;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathDataLine {
    WebCore::FloatPoint start();
    WebCore::FloatPoint end();
};

[AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathDataLineColorThickness {
    WebCore::PathDataLine line;
    WebCore::PackedColor::RGBA color;
    float thickness;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathDataQuadCurve {
    WebCore::FloatPoint start;
    WebCore::FloatPoint controlPoint;
    WebCore::FloatPoint endPoint;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathDataBezierCurve {
    WebCore::FloatPoint start;
    WebCore::FloatPoint controlPoint1;
    WebCore::FloatPoint controlPoint2;
    WebCore::FloatPoint endPoint;
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathDataArc {
    WebCore::FloatPoint start;
    WebCore::FloatPoint controlPoint1;
    WebCore::FloatPoint controlPoint2;
    float radius;
};

header: <WebCore/PathSegment.h>
[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct WebCore::PathCloseSubpath {
};

[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] class WebCore::PathSegment {
    WebCore::PathSegment::Data data();
};

[Swift] using WebCore::PathSegment::Data = Variant<WebCore::PathMoveTo, WebCore::PathLineTo, WebCore::PathQuadCurveTo, WebCore::PathBezierCurveTo, WebCore::PathArcTo, WebCore::PathArc, WebCore::PathClosedArc, WebCore::PathEllipse, WebCore::PathEllipseInRect, WebCore::PathRect, WebCore::PathRoundedRect, WebCore::PathContinuousRoundedRect, WebCore::PathDataLine, WebCore::PathDataQuadCurve, WebCore::PathDataBezierCurve, WebCore::PathDataArc, WebCore::PathCloseSubpath>;

#if ENABLE(GPU_PROCESS_CG_RENDERER_SWIFT)
header: "RemoteCGRendererStyleKind.h"
[Swift] enum class WebKit::RemoteCGRendererStyleKind : uint8_t {
    None,
    DropShadow,
    GaussianBlur,
    ColorMatrix
};

header: <WebCore/CGRendererSwiftBridge.h>
[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct CGRendererColorData {
    float c1;
    float c2;
    float c3;
    float alpha;
    uint32_t packedColor;
    [Validator='WTF::isValidEnum<WebCore::ColorSpaceName>(*colorSpace)', SwiftValidator='IPCTypes.ColorSpaceName(rawValue: colorSpace) != nil'] uint8_t colorSpace;
    [Validator='*form <= 2', SwiftValidator='form <= 2'] uint8_t form;
    bool isSemantic;
    bool usesFunctionSerialization;
};

header: <WebCore/CGRendererSwiftBridge.h>
[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct CGRendererShadowValues {
    float width;
    float height;
    float radius;
    float opacity;
    uint32_t packedColor;
    bool isValid;
    bool isVisible;
    bool legacyRadius;
};

header: <WebCore/CGRendererSwiftBridge.h>
[Swift, AdditionalEncoder=StreamConnectionEncoder, CustomHeader] struct CGRendererColorValue {
    CGRendererColorData data;
    uint32_t packedColor;
    bool isPacked;
    bool isVisible;
};
#endif
