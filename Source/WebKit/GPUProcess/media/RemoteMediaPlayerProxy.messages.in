#if ENABLE(GPU_PROCESS) && ENABLE(VIDEO)

[
    DispatchedFrom=WebContent,
    DispatchedTo=GPU,
    EnabledBy=UseGPUProcessForMediaEnabled,
    SwiftImplementation,
    SwiftReceiverBuildEnabledBy=GPU_PROCESS_MEDIA_SWIFT
]
messages -> RemoteMediaPlayerProxy {
    PrepareForPlayback(bool privateMode, enum:uint8_t WebCore::MediaPlayerPreload preload, bool preservesPitch, enum:uint8_t WebCore::MediaPlayerPitchCorrectionAlgorithm pitchCorrectionAlgorithm, bool prepareToPlay, bool prepareForRendering, WebCore::IntSize presentationSize, float videoContentScale, bool isFullscreen, enum:uint8_t WebCore::DynamicRangeMode mode, WebCore::PlatformDynamicRangeLimit platformDynamicRangeLimit)

    Load(URL url, std::optional<WebKit::SandboxExtensionHandle> sandboxExtension, struct WebCore::MediaPlayerLoadOptions options) -> (struct WebKit::RemoteMediaPlayerConfiguration playerConfiguration)
    CancelLoad() SwiftTypes SwiftSyncHandler

    PrepareToPlay() SwiftTypes SwiftSyncHandler

    Play() SwiftTypes SwiftSyncHandler
    Pause() SwiftTypes SwiftSyncHandler

    SetVolumeLocked(bool volumeLocked) SwiftTypes SwiftSyncHandler
    SetVolume(double volume) SwiftTypes SwiftSyncHandler
    SetMuted(bool muted) SwiftTypes SwiftSyncHandler

    SeekToTarget(struct WebCore::SeekTarget target) -> (std::expected<WebCore::MediaTimeUpdateData, WebCore::PlatformMediaError> result)

    SetPreload(enum:uint8_t WebCore::MediaPlayerPreload preload) SwiftTypes SwiftSyncHandler
    SetPrivateBrowsingMode(bool privateMode) SwiftTypes SwiftSyncHandler
    SetPreservesPitch(bool preservesPitch) SwiftTypes SwiftSyncHandler
    SetPitchCorrectionAlgorithm(enum:uint8_t WebCore::MediaPlayerPitchCorrectionAlgorithm algorithm) SwiftTypes SwiftSyncHandler

    PrepareForRendering() SwiftTypes SwiftSyncHandler
    SetPageIsVisible(bool visible) SwiftTypes SwiftSyncHandler
    SetViewportVisibility(enum:uint8_t WebCore::MediaPlayerViewportVisibility visibility) SwiftTypes SwiftSyncHandler
    SetShouldMaintainAspectRatio(bool maintainAspectRatio) SwiftTypes SwiftSyncHandler
    AcceleratedRenderingStateChanged(bool canBeAccelerated) SwiftTypes SwiftSyncHandler
    SetShouldDisableSleep(bool disable) SwiftTypes SwiftSyncHandler
    SetRate(double rate) SwiftTypes SwiftSyncHandler
    DidLoadingProgress() -> (bool flag) SwiftTypes

#if ENABLE(VIDEO_PRESENTATION_MODE)
    [EnabledBy=VideoPresentationManagerEnabled || VideoPresentationModeAPIEnabled] UpdateVideoFullscreenInlineImage() SwiftTypes SwiftSyncHandler
    [EnabledBy=VideoPresentationManagerEnabled || VideoPresentationModeAPIEnabled] SetVideoFullscreenMode(uint32_t mode) SwiftTypes SwiftSyncHandler
    [EnabledBy=VideoPresentationManagerEnabled || VideoPresentationModeAPIEnabled] SetVideoFullscreenGravity(enum:uint8_t WebCore::MediaPlayerVideoGravity gravity) SwiftTypes SwiftSyncHandler
    [EnabledBy=VideoPresentationManagerEnabled || VideoPresentationModeAPIEnabled] VideoFullscreenStandbyChanged(bool standby) SwiftTypes SwiftSyncHandler
#endif

    SetBufferingPolicy(enum:uint8_t WebCore::MediaPlayerBufferingPolicy policy) SwiftTypes SwiftSyncHandler
    SetPresentationSize(WebCore::IntSize size) SwiftTypes SwiftSyncHandler

#if PLATFORM(COCOA)
    SetVideoLayerSizeFenced(WebCore::FloatSize size, struct MachSendRightAnnotated sendRightAnnotated)
#endif

#if ENABLE(WIRELESS_PLAYBACK_TARGET)
    SetWirelessVideoPlaybackDisabled(bool disabled) SwiftTypes SwiftSyncHandler
    SetWirelessPlaybackTarget(WebKit::MediaPlaybackTargetContextSerialized target)
    SetShouldPlayToPlaybackTarget(bool shouldPlay) SwiftTypes SwiftSyncHandler
#endif

#if ENABLE(LEGACY_ENCRYPTED_MEDIA)
    [EnabledBy=LegacyEncryptedMediaAPIEnabled] SetLegacyCDMSession(std::optional<WebKit::RemoteLegacyCDMSessionIdentifier> instanceId) SwiftTypes SwiftSyncHandler
    [EnabledBy=LegacyEncryptedMediaAPIEnabled] KeyAdded() SwiftTypes SwiftSyncHandler
#endif

#if ENABLE(ENCRYPTED_MEDIA)
    [EnabledBy=EncryptedMediaAPIEnabled] CdmInstanceAttached(WebKit::RemoteCDMInstanceIdentifier instanceId) SwiftTypes SwiftSyncHandler
    [EnabledBy=EncryptedMediaAPIEnabled] CdmInstanceDetached(WebKit::RemoteCDMInstanceIdentifier instanceId) SwiftTypes SwiftSyncHandler
    [EnabledBy=EncryptedMediaAPIEnabled] AttemptToDecryptWithInstance(WebKit::RemoteCDMInstanceIdentifier instanceId) SwiftTypes SwiftSyncHandler
#endif

#if ENABLE(LEGACY_ENCRYPTED_MEDIA) && ENABLE(ENCRYPTED_MEDIA)
    [EnabledBy=LegacyEncryptedMediaAPIEnabled] SetShouldContinueAfterKeyNeeded(bool should) SwiftTypes SwiftSyncHandler
#endif

    ApplicationWillResignActive() SwiftTypes SwiftSyncHandler
    ApplicationDidBecomeActive() SwiftTypes SwiftSyncHandler

    NotifyTrackModeChanged() SwiftTypes SwiftSyncHandler
    TracksChanged() SwiftTypes SwiftSyncHandler

    AudioTrackSetEnabled(uint64_t trackId, bool enabled) SwiftTypes SwiftSyncHandler
    VideoTrackSetSelected(uint64_t trackId, bool selected) SwiftTypes SwiftSyncHandler
    TextTrackSetMode(uint64_t trackId, enum:uint8_t WebCore::InbandTextTrackPrivateMode mode) SwiftTypes SwiftSyncHandler

    PerformTaskAtTime(MediaTime mediaTime) -> (std::optional<MediaTime> mediaTime) SwiftTypes
    IsCrossOrigin(WebCore::SecurityOriginData origin) -> (std::optional<bool> crossOrigin) Synchronous

    SetVideoPlaybackMetricsUpdateInterval(double interval) SwiftTypes SwiftSyncHandler

    SetPreferredDynamicRangeMode(enum:uint8_t WebCore::DynamicRangeMode mode) SwiftTypes SwiftSyncHandler
    SetPlatformDynamicRangeLimit(WebCore::PlatformDynamicRangeLimit platformDynamicRangeLimit)

#if PLATFORM(IOS_FAMILY)
    ErrorLog() -> (String errorLog) Synchronous
    AccessLog() -> (String accessLog) Synchronous
    SetSceneIdentifier(String sceneIdentifier)
#endif

#if ENABLE(WEB_AUDIO)
    [EnabledBy=WebAudioEnabled] CreateAudioSourceProvider()
    [EnabledBy=WebAudioEnabled] SetShouldEnableAudioSourceProvider(bool shouldEnable)
#endif

#if PLATFORM(COCOA)
    NativeImageForCurrentTime() -> (std::optional<MachSendRight> sendRight, WebCore::ColorSpace colorSpace) Synchronous
    ColorSpace() -> (WebCore::ColorSpace colorSpace) Synchronous
#endif
    VideoFrameForCurrentTimeIfChanged(WebKit::RemoteVideoFrameReference reference) -> (struct std::optional<WebKit::RemoteVideoFrameProxyProperties> videoFrame, bool changed) Synchronous
    BitmapImageForCurrentTime() -> (std::optional<WebCore::ShareableBitmapHandle> image)

    PlayAtHostTime(MonotonicTime time)
    PauseAtHostTime(MonotonicTime time)

    StartVideoFrameMetadataGathering() SwiftTypes SwiftSyncHandler
    StopVideoFrameMetadataGathering() SwiftTypes SwiftSyncHandler

    PlayerContentBoxRectChanged(WebCore::LayoutRect contentRect)

    SetShouldDisableHDR(bool shouldDisable) SwiftTypes SwiftSyncHandler

    RequestHostingContext() -> (struct WebCore::HostingContext layerHostingContext)

    SetShouldCheckHardwareSupport(bool value) SwiftTypes SwiftSyncHandler

#if HAVE(SPATIAL_TRACKING_LABEL)
    SetDefaultSpatialTrackingLabel(String defaultSpatialTrackingLabel) SwiftTypes SwiftSyncHandler
    SetSpatialTrackingLabel(String spatialTrackingLabel) SwiftTypes SwiftSyncHandler
#endif

#if HAVE(SPATIAL_AUDIO_EXPERIENCE)
    SetPrefersSpatialAudioExperience(bool value) SwiftTypes SwiftSyncHandler
#endif

    AudioOutputDeviceChanged(String deviceId) SwiftTypes SwiftSyncHandler
    IsInFullscreenOrPictureInPictureChanged(bool value) SwiftTypes SwiftSyncHandler
    SetSoundStageSize(enum:uint8_t WebCore::MediaPlayerSoundStageSize value) SwiftTypes SwiftSyncHandler

    SetHasMessageClientForTesting(bool value)

#if PLATFORM(MAC)
    ScreenReservedChanged(bool value) SwiftTypes SwiftSyncHandler
#endif
}

#endif
