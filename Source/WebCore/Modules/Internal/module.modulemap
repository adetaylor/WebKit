// WebCore's own headers, for WebCore's Swift; only its Swift compile searches this directory
// (SWIFT_INCLUDE_PATHS, or -I in CMake). WebCoreInternal stays first. Every WebCore header that a
// listed header includes has to be listed too, as its own submodule. Otherwise the compile reaches
// it through the whole WebCore_Private umbrella or parses it into two submodules, and fails.
module WebCore_Internal [system] {
    explicit module WebCoreInternal {
        requires cplusplus20
        header "WebCoreInternal.h"
        export *
    }

    explicit module PlatformExportMacros {
        requires cplusplus20
        header "../../platform/PlatformExportMacros.h"
        export *
    }

