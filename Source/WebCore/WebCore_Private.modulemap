framework module WebCore_Private [system] {
    explicit module PlatformExportMacros {
        header "PlatformExportMacros.h"
        export *
    }

    explicit module Core {
        umbrella "PrivateHeaders"

        requires cplusplus

        // Module norms would expose nested modules here, but this causes some Swift issues -
        // being resolved as rdar://166064408
        export *
    }
}
