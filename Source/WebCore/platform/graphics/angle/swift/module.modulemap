// ANGLE's C API, with the shims that let the WebGL island's Swift call it without unsafe, and the memory C++ lends it.
module WebCoreANGLE {
    requires cplusplus
    header "WebCoreANGLE.h"
    header "GLLentMemory.h"
    export *

    // The old path of the island's entry points that take Swift arrays, for systems before OS 26.
    explicit module BeforeOS26 {
        header "WebCoreANGLEBeforeOS26.h"
        export *
    }

    // ANGLE's EGL for the Cocoa platform.
    explicit module Cocoa {
        requires objc
        header "cocoa/WebCoreANGLECocoa.h"
        export *
    }
}

// The underlying clang module of the WebGL island's Swift module, WebCoreWebGL.
module WebCoreWebGL {
    requires cplusplus
    header "WebCoreWebGL.h"
    export *
}
