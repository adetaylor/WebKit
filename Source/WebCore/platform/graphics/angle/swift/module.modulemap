// ANGLE's C API, with the shims that let the WebGL island's Swift call it without unsafe, and the memory C++ lends it.
module WebCoreANGLE {
    requires cplusplus
    header "WebCoreANGLE.h"
    header "GLLentMemory.h"
    export *
}

// The underlying clang module of the WebGL island's Swift module, WebCoreWebGL.
module WebCoreWebGL {
    requires cplusplus
    header "WebCoreWebGL.h"
    export *
}
