// WebCoreEME, the encrypted media Swift that WebCore's Swift and WebKit's Swift both import: a static library that
// WebCore.xcconfig force-loads into WebCore.framework. Its API has no C++ types. Its .swiftmodule is in
// BUILT_PRODUCTS_DIR, where WebCore's and WebKit's Swift find it, as libJavaScriptCore's JSCSwift module is.

PRODUCT_NAME = WebCoreEME;
PRODUCT_MODULE_NAME = WebCoreEME;
EXECUTABLE_PREFIX = lib;
INSTALL_PATH = $(WK_LIBRARY_INSTALL_PATH);
SKIP_INSTALL = YES;
SWIFT_INSTALL_OBJC_HEADER = NO;
SWIFT_LIBRARY_LEVEL = spi;

// WebCore builds for distribution, and its Swift API uses this module's types.
BUILD_LIBRARY_FOR_DISTRIBUTION = YES;

// The platform's ENABLE_* conditions, which WebCore's Derived Sources target writes.
OTHER_SWIFT_FLAGS = $(inherited) @$(BUILT_PRODUCTS_DIR)/DerivedSources/WebCore/platform-enabled-swift-args.$(arch).resp -Werror DeprecatedDeclaration -Werror SendableClosureCaptures;
SWIFT_OBJC_INTEROP_MODE = objcxx;
_SWIFT_EXPLICIT_MODULES_ALLOW_CXX_INTEROP = YES;
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES;
SWIFT_ENABLE_COMPILE_CACHE = NO;
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated;
SWIFT_STRICT_CONCURRENCY = complete;
