// The WebGL island's Swift module, a static library that WebCore.framework force-loads. It has WebCore's Swift settings
// and none of the framework's.
#include "WebCore.xcconfig"

PRODUCT_NAME = WebCoreWebGL;
MACH_O_TYPE = staticlib;
EXECUTABLE_PREFIX = lib;
INSTALL_PATH = ;
SKIP_INSTALL = YES;
INSTALLHDRS_COPY_PHASE = NO;
INSTALLHDRS_SCRIPT_PHASE = NO;
INFOPLIST_FILE = ;
DYLIB_INSTALL_NAME_BASE = ;
UNEXPORTED_SYMBOLS_FILE = ;
WK_WEBGL_ISLAND_LDFLAGS = ;
WK_WEBCOREEME_TBD_FLAGS_ENABLE_WEBCORE_SWIFT = ;
GCC_PREFIX_HEADER = ;
GCC_PRECOMPILE_PREFIX_HEADER = NO;
SUPPORTS_TEXT_BASED_API = NO;

// The island's own clang modules: WebCoreANGLE, and WebCoreWebGL, which its Swift module extends.
DEFINES_MODULE = NO;
MODULEMAP_FILE = ;
MODULEMAP_PRIVATE_FILE = ;
ENABLE_MODULE_VERIFIER = NO;
WK_WEBGL_ISLAND_SOURCE_DIR = $(SRCROOT)/platform/graphics/angle/swift;
SWIFT_INCLUDE_PATHS = $(inherited) $(WK_WEBGL_ISLAND_SOURCE_DIR);
WK_WEBGL_ISLAND_SWIFT_FLAGS = -import-underlying-module -Xfrontend -disable-cross-import-overlays -Xcc -I$(WK_WEBGL_ISLAND_SOURCE_DIR) -Xcc -DWEBCORE_EXPORT=;

// WebCore's C++ calls it through its generated header, and WebKit's Swift through its .swiftmodule.
BUILD_LIBRARY_FOR_DISTRIBUTION = NO;
SWIFT_LIBRARY_LEVEL = ;
SWIFT_OBJC_INTERFACE_HEADER_NAME = WebCoreWebGLSwift-Generated.h;
SWIFT_INSTALL_OBJC_HEADER = NO;
