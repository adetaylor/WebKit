// WebCoreSwiftSupport, pure Swift value types that WebCoreEME, WebCore's Swift and WebKit's Swift import: a static
// library that WebCore.xcconfig force-loads into WebCore.framework. Its .swiftmodule is in BUILT_PRODUCTS_DIR, where they
// find it, as they find WebCoreEME's.

PRODUCT_NAME = WebCoreSwiftSupport;
PRODUCT_MODULE_NAME = WebCoreSwiftSupport;
EXECUTABLE_PREFIX = lib;
INSTALL_PATH = $(WK_LIBRARY_INSTALL_PATH);
SKIP_INSTALL = YES;
SWIFT_INSTALL_OBJC_HEADER = NO;
SWIFT_LIBRARY_LEVEL = spi;

OTHER_SWIFT_FLAGS = $(inherited) -Werror DeprecatedDeclaration -Werror SendableClosureCaptures;
SWIFT_OBJC_INTEROP_MODE = objcxx;
_SWIFT_EXPLICIT_MODULES_ALLOW_CXX_INTEROP = YES;
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES;
SWIFT_ENABLE_COMPILE_CACHE = NO;
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated;
SWIFT_STRICT_CONCURRENCY = complete;
