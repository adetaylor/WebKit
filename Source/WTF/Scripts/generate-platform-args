#!/usr/bin/env python3
import argparse
import re
import shutil
import subprocess
import sys

# Runs a clang preprocess command (passed after `--`), parses its `-dM` output,
# and writes a swiftc @-response file. The same flow is used by both build
# systems; they construct slightly different clang commands and pass slightly
# different flags, but the script logic is single-flow.
#
# Output format (one token per line, swiftc-response-file convention):
#   -DNAME              for every truthy HAVE_/USE_/ENABLE_/WTF_PLATFORM/ASSERT_
#                       macro the preprocess derives, used for Swift's #if
#                       conditional compilation.
#   -Xcc -DNAME=VALUE   for every entry in --cmakeconfig (if given), so the
#                       Swift clang importer's view of ENABLE()/HAVE() macros
#                       agrees with regular C++ compilation. Only cmake builds
#                       use this; the Xcode build's clang importer is fed
#                       through xcconfig instead.
#
# Multi-arch is expressed by passing one or more --archs values; --output,
# --depfile and the clang command may contain a literal {arch} which is
# replaced per iteration. cmake builds pass a single arch and no {arch}
# placeholders.

DEFINE_RE = re.compile(r'^#define (\w+) (.+)', re.MULTILINE)
PLATFORM_PREFIX_RE = re.compile(r'^(HAVE_|USE_|ENABLE_|WTF_PLATFORM|ASSERT_)')
CMAKECONFIG_DEFINE_RE = re.compile(r'^#define (\w+) (.+)$')


def platform_defines_from_dM(stdout):
    """Parse `clang -E -dM` output and return the names of the truthy
    HAVE_/USE_/ENABLE_/WTF_PLATFORM_/ASSERT_ macros. Resolves simple macro
    indirection: clang -dM emits macros alphabetically rather than
    topologically, so a macro may reference another we have not yet seen;
    iterate to a fixed point with a bound to avoid recursive definitions
    looping forever."""
    definitions = {}
    for m in re.finditer(DEFINE_RE, stdout):
        name = m.group(1)
        value = m.group(2)
        if value == '1':
            definitions[name] = 1
        elif value == '0':
            definitions[name] = 0
        else:
            definitions[name] = value
    for _ in range(10):
        changed = False
        for name, value in definitions.items():
            if type(value) == str and value in definitions:
                definitions[name] = definitions[value]
                changed = True
        if not changed:
            break
    return [
        name for name, value in definitions.items()
        if value == 1 and PLATFORM_PREFIX_RE.match(name)
    ]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--output', required=True,
                    help='Resp file path. May contain {arch}.')
    ap.add_argument('--depfile',
                    help='Per-iteration depfile path. May contain {arch}. The '
                         'clang command is responsible for actually writing '
                         'this file (via -MD -MF); the script only reads it '
                         'when concatenating into --combined-depfile.')
    ap.add_argument('--combined-depfile',
                    help='Single depfile to concatenate per-iteration depfiles '
                         'into. Used by the Xcode build phase, which declares '
                         'one dependencyFile across all archs.')
    ap.add_argument('--archs', nargs='+', default=[''],
                    help='Iterate once per value. The {arch} placeholder in '
                         '--output, --depfile and the clang command is '
                         'replaced. Defaults to a single un-templated run.')
    ap.add_argument('--cmakeconfig',
                    help='Optional cmakeconfig.h whose #defines are emitted as '
                         '-Xcc -DNAME=VALUE entries to seed the clang importer.')
    ap.add_argument('command', nargs=argparse.REMAINDER,
                    help='Clang preprocess command (preceded by --).')
    args = ap.parse_args()

    cmd_template = args.command
    if cmd_template and cmd_template[0] == '--':
        cmd_template = cmd_template[1:]
    if not cmd_template:
        ap.error('clang command is required after --')

    cmake_seeds = []
    if args.cmakeconfig:
        with open(args.cmakeconfig) as f:
            for line in f:
                m = CMAKECONFIG_DEFINE_RE.match(line.strip())
                if m:
                    cmake_seeds.append((m.group(1), m.group(2)))

    combined_fd = (open(args.combined_depfile, 'w')
                   if args.combined_depfile else None)
    try:
        for arch in args.archs:
            output_path = args.output.replace('{arch}', arch)
            depfile_path = (args.depfile.replace('{arch}', arch)
                            if args.depfile else None)
            cmd = [c.replace('{arch}', arch) for c in cmd_template]

            result = subprocess.run(cmd, capture_output=True, text=True)
            if result.returncode != 0:
                sys.stderr.write(result.stderr)
                sys.exit(result.returncode)

            if combined_fd and depfile_path:
                # Concatenate so a header that's only imported on some archs
                # still triggers a rebuild via the combined depfile.
                shutil.copyfileobj(open(depfile_path), combined_fd)

            swift_defines = platform_defines_from_dM(result.stdout)

            out_lines = []
            for name in swift_defines:
                out_lines.append('-D' + name)
            for name, value in cmake_seeds:
                out_lines.append('-Xcc')
                out_lines.append(f'-D{name}={value}')

            with open(output_path, 'w') as f:
                f.write('\n'.join(out_lines))
                f.write('\n')
    finally:
        if combined_fd:
            combined_fd.close()


if __name__ == '__main__':
    main()
