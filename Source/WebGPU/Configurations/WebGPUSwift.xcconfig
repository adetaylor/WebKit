// Whether WebGPU uses Swift, including the WGSL compiler (WGSL, wgslc, wgslfuzz targets and TestWGSL's
// tests). Included by Base.xcconfig and by Tools/TestWebKitAPI/Configurations/TestWGSL.xcconfig.

ENABLE_WEBGPU_SWIFT = ;

ENABLE_WEBGPU_SWIFT[sdk=macosx*] = ENABLE_WEBGPU_SWIFT;

ENABLE_WEBGPU_SWIFT[sdk=iphone*] = ENABLE_WEBGPU_SWIFT;
ENABLE_WEBGPU_SWIFT[sdk=iphone*26.2*] = ;
ENABLE_WEBGPU_SWIFT[sdk=iphone*26.3*] = ;

// WebGPU has a problem on iOS simulator on older SDKs
// (https://bugs.webkit.org/show_bug.cgi?id=300146).
ENABLE_WEBGPU_SWIFT[sdk=iphonesimulator26*] = ;

ENABLE_WEBGPU_SWIFT[sdk=xr*] = ENABLE_WEBGPU_SWIFT;
ENABLE_WEBGPU_SWIFT[sdk=xr*26.2*] = ;
ENABLE_WEBGPU_SWIFT[sdk=xr*26.3*] = ;
ENABLE_WEBGPU_SWIFT[sdk=xrsimulator26*] = ;

// WebKit builds C++-interop Swift on tvOS and watchOS from the 27 SDKs.
ENABLE_WEBGPU_SWIFT[sdk=appletv*] = ENABLE_WEBGPU_SWIFT;
ENABLE_WEBGPU_SWIFT[sdk=appletv*26*] = ;

ENABLE_WEBGPU_SWIFT[sdk=watch*] = ENABLE_WEBGPU_SWIFT;
ENABLE_WEBGPU_SWIFT[sdk=watch*26*] = ;
