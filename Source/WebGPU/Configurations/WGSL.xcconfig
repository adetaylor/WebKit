EXECUTABLE_PREFIX = lib;
INSTALL_PATH = $(WGSL_INSTALL_PATH_PREFIX)$(WK_LIBRARY_INSTALL_PATH);
PRODUCT_NAME = wgsl;

// The Swift module WGSL: standard library only, no C++ interop. Imported by WebGPU's bridge, wgslc,
// wgslfuzz and TestWGSL.
PRODUCT_MODULE_NAME = WGSL;
SWIFT_INSTALL_OBJC_HEADER = NO;
SWIFT_OBJC_INTERFACE_HEADER_NAME = ;
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated;
SWIFT_STRICT_CONCURRENCY = complete;
BUILD_LIBRARY_FOR_DISTRIBUTION = NO;
SWIFT_COMPILATION_MODE = wholemodule;
SWIFT_COMPILATION_MODE[config=Debug] = singlefile;
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug] = $(inherited) WGSL_UNOPTIMIZED;
// WebGPU's installapi imports this module, which Xcode only emits for a static library that adopts this,
// even though the library is not installed. installapi runs script phases but no build rules, hence the
// script phase that generates TypeDeclarations.swift.
SUPPORTS_TEXT_BASED_API = YES;
INSTALLAPI_IGNORE_SKIP_INSTALL = YES;
INSTALLHDRS_SCRIPT_PHASE = YES;

// Without Swift only WGSLStub.c is built, so libwgsl.a still exists for the targets that link it.
EXCLUDED_SOURCE_FILE_NAMES = $(EXCLUDED_SOURCE_FILE_NAMES_$(ENABLE_WEBGPU_SWIFT));
EXCLUDED_SOURCE_FILE_NAMES_ = *.swift *.rb;
EXCLUDED_SOURCE_FILE_NAMES_ENABLE_WEBGPU_SWIFT = ;

OTHER_LDFLAGS = $(inherited) $(SOURCE_VERSION_LDFLAGS);

SKIP_INSTALL = $(SKIP_INSTALL_$(FORCE_TOOL_INSTALL));
SKIP_INSTALL_ = YES;
SKIP_INSTALL_NO = YES;
SKIP_INSTALL_YES = NO;
