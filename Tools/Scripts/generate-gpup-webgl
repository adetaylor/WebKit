# The messages that the GL logic handles go to RemoteGraphicsContextGL. With split_receivers, the others go to
# RemoteGraphicsContextGLResources, a C++ receiver on the same stream connection: their handlers take IPC handles or
# need C++ objects, or their replies have no Swift form. With swift_gl_receiver, RemoteGraphicsContextGL is a Swift
# receiver that calls the WebGL island.
split_receivers = True
swift_gl_receiver = False

# Generated functions whose messages go to RemoteGraphicsContextGLResources, besides the WebXR ones.
resources_func_names = set(["activeAttribs", "activeUniforms", "getTransformFeedbackVarying", "readPixelsBufferObject"])

gl_cxx_template_messages = """    void EnsureExtensionEnabled(WebCore::GCGLExtension extension) StreamBatched
    void GetErrors() -> (GCGLErrorCodeSet returnValue) Synchronous
    void DrawBuffers(std::span<const uint32_t> bufs) StreamBatched
    void DrawBuffersEXT(std::span<const uint32_t> bufs) StreamBatched
    void InvalidateFramebuffer(uint32_t target, std::span<const uint32_t> attachments)
    void InvalidateSubFramebuffer(uint32_t target, std::span<const uint32_t> attachments, int32_t x, int32_t y, int32_t width, int32_t height)"""

gl_swift_template_messages = """    void EnsureExtensionEnabled(uint8_t glExtension) StreamBatched
    void GetErrors() -> (uint8_t returnValue) Synchronous
    void DrawBuffers(std::span<const uint32_t> bufs) StreamBatched
    void DrawBuffersEXT(std::span<const uint32_t> bufs) StreamBatched
    void InvalidateFramebuffer(uint32_t glTarget, std::span<const uint32_t> attachments)
    void InvalidateSubFramebuffer(uint32_t glTarget, std::span<const uint32_t> attachments, int32_t x, int32_t y, int32_t width, int32_t height)"""


def gl_messages_template():
    attributes = ",\n    SwiftReceiver,\n    SwiftTypes" if swift_gl_receiver else ""
    template_messages = gl_swift_template_messages if swift_gl_receiver else gl_cxx_template_messages
    return (
        template_preamble
        + "#if ENABLE(GPU_PROCESS) && ENABLE(WEBGL)\n\n[\n    DispatchedFrom=WebContent,\n    DispatchedTo=GPU,\n    EnabledBy=WebGLEnabled"
        + attributes
        + "\n]\nmessages -> RemoteGraphicsContextGL Stream {{\n"
        + template_messages
        + "{}\n}}\n\n#endif\n"
    )


