"""Regenerates the WGSL compiler's byte-exact goldens (Tools/TestWebKitAPI/Tests/WGSL/goldens/*.golden).

It runs the WGSLGoldenTests suite of TestWGSL in record mode (WGSL_GOLDEN_RECORD_DIR), which writes the dump the
compiler produces for every case instead of comparing it, then rewrites the golden files from those dumps and prints
the cases and layers that changed. Every intentional change of the compiler's output (MSL, messages and spans,
reflection, minBindingSize write-back, pipeline constants, workgroup sizes) then shows up as a golden diff.

A shader added to Tests/WGSL/shaders/ becomes a new shaders.golden case, and --add-corpus/--add-inline add others;
the Swift dumper derives their plans. A case whose shader was deleted is dropped.

Golden file grammar (version 1):

    WGSLGOLDEN 1
    # <comment>
    case STR
    source-file STR | source-inline N NL <N bytes> NL
    plan N NL <N bytes: the case's WGSLJOB 1 job from its `encoding` line to its `end` line, compressed> NL
    expect N NL <N bytes: the WGSLDUMP 1 dump the job produces, compressed> NL
    endcase

STR is the dump grammar's quoted string. `source-file` names a file of Tests/WGSL/shaders. The test runs the job
`WGSLJOB 1`, `id <case>`, the source, then the plan.

Compression: a plan or an expect text is a sequence of LF-terminated lines. A line `=copy prev F N` stands for the
lines F..F+N-1 (0-based) of the same text of the previous case in the file, expanded; `=copy this F N` for lines of
this text expanded so far. Any other line starting with a backslash stands for itself without the backslash (an
escaped literal line starting with `=` or a backslash); every other line stands for itself.
"""

import argparse
import collections
import difflib
import os
import re
import shutil
import subprocess
import sys
import tempfile

GOLDEN_FILES = ('shaders', 'inline', 'corpus')
V1_FILES = ('shaders', 'corpus')
MAGIC = b'WGSLGOLDEN 1\n'
HEADER_TEMPLATE = ('# Generated by Tools/Scripts/update-wgsl-goldens (source: %s). Do not edit.\n'
                   '# Grammar and "=copy prev|this FIRST COUNT" compression: see Tools/Scripts/update-wgsl-goldens.\n')

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
TESTS_DIR = os.path.normpath(os.path.join(SCRIPT_DIR, '..', 'TestWebKitAPI', 'Tests', 'WGSL'))

BASE_PLANS = {
    'golden-v1': b'encoding wtf-utf8-latin1\nconfig webgpu\nlayers check,reflect,units\nend\n',
    'golden-inline': b'encoding wtf-utf8-latin1\nconfig %s\nlayers check,reflect,units\n'
                     b'unit\n  ep @all layout=auto\n  generate family=4 validation=0 msl=hash\nend\n',
}


# The expect text of a case in a `<file>.pending` list of new cases (record mode), which the test derives a plan for
# (golden-v1 files) and records.
PENDING_DUMP = b'pending\n'


class GoldenFormatError(Exception):
    pass


class Case:
    """A case with its plan and dump expanded."""
    __slots__ = ('name', 'source_file', 'source_inline', 'plan', 'dump')

    def __init__(self, name, source_file=None, source_inline=None, plan=b'', dump=b''):
        self.name = name
        self.source_file = source_file
        self.source_inline = source_inline
        self.plan = plan
        self.dump = dump


# MARK: - STR (the WGSLDUMP 1 quoting, over UTF-16 code units)

def quote(text):
    units = text.encode('utf-16-le', 'surrogatepass')
    out = ['"']
    for i in range(0, len(units), 2):
        u = units[i] | (units[i + 1] << 8)
        if u == 0x22:
            out.append('\\"')
        elif u == 0x5C:
            out.append('\\\\')
        elif u == 0x0A:
            out.append('\\n')
        elif u == 0x09:
            out.append('\\t')
        elif u == 0x0D:
            out.append('\\r')
        elif 0x20 <= u <= 0x7E:
            out.append(chr(u))
        else:
            out.append('\\u%04x' % u)
    out.append('"')
    return ''.join(out)


def unquote(data):
    """The text of a STR (bytes including the quotes)."""
    if len(data) < 2 or data[:1] != b'"' or data[-1:] != b'"':
        raise GoldenFormatError('bad STR %r' % data[:80])
    units = []
    i = 1
    end = len(data) - 1
    escapes = {ord('"'): 0x22, ord('\\'): 0x5C, ord('n'): 0x0A, ord('t'): 0x09, ord('r'): 0x0D}
    while i < end:
        c = data[i]
        if c != 0x5C:
            units.append(c)
            i += 1
            continue
        if i + 1 >= end:
            raise GoldenFormatError('bad escape in %r' % data[:80])
        e = data[i + 1]
        if e == ord('u') and i + 6 <= end:
            units.append(int(data[i + 2:i + 6], 16))
            i += 6
        elif e in escapes:
            units.append(escapes[e])
            i += 2
        else:
            raise GoldenFormatError('bad escape in %r' % data[:80])
    return b''.join(bytes((u & 0xFF, u >> 8)) for u in units).decode('utf-16-le', 'surrogatepass')


def name_order(case):
    return case.name.encode('utf-16-be', 'surrogatepass')


def record_file_name(name):
    """The record-mode file stem of a case: its UTF-8 bytes with every byte outside [A-Za-z0-9._-] as %XX."""
    return ''.join(chr(b) if (0x30 <= b <= 0x39 or 0x41 <= b <= 0x5A or 0x61 <= b <= 0x7A or b in b'._-') else '%%%02X' % b
                   for b in name.encode('utf-8'))


# MARK: - Compression

_COPY = re.compile(rb'^=copy (prev|this) (\d+) (\d+)$')
_CANDIDATES = 48


def _split_lines(text):
    if not text.endswith(b'\n'):
        raise GoldenFormatError('text does not end with LF')
    return text[:-1].split(b'\n')


_BLOCK_HEADER = re.compile(rb'^(?:ast\.parse|ast\.check|ast\.after|  ast\.prepare|  ast\.after|    msl) (?:utf8|esc) (\d+)$')


def _block_lines(lines):
    """The indices of the lines that belong to a BLOCK's payload (an MSL text), including its terminating LF."""
    inside = set()
    offset = 0
    block_end = -1
    for k, line in enumerate(lines):
        if offset <= block_end:
            inside.add(k)
        else:
            m = _BLOCK_HEADER.match(line)
            if m:
                block_end = offset + len(line) + 1 + int(m.group(1))
        offset += len(line) + 1
    return inside


def compress(text, previous, is_dump=False):
    """`text` (LF-terminated lines) with runs of lines that `previous` or the text itself already holds as =copy lines.

    In a dump, the lines of an MSL block are only copied from the same dump, so that each case's MSL reads on its own.
    """
    lines = _split_lines(text)
    before = _split_lines(previous) if previous else []
    own_only = _block_lines(lines) if is_dump else set()
    index_before = collections.defaultdict(list)
    for k, line in enumerate(before):
        index_before[line].append(k)
    index_this = collections.defaultdict(list)
    out = []
    i = 0
    while i < len(lines):
        best = (0, b'', 0)
        for source, sequence, index, limit in ((b'this', lines, index_this, i), (b'prev', before, index_before, len(before))):
            if source == b'prev' and i in own_only:
                continue
            for start in reversed(index.get(lines[i], ())[-_CANDIDATES:]):
                n = 0
                while i + n < len(lines) and start + n < limit and sequence[start + n] == lines[i + n] and \
                        (source == b'this' or i + n not in own_only):
                    n += 1
                if n > best[0]:
                    best = (n, source, start)
        n, source, start = best
        directive = b'=copy %s %d %d' % (source, start, n)
        if n and sum(len(line) + 1 for line in lines[i:i + n]) > len(directive) + 1:
            out.append(directive)
            for k in range(i, i + n):
                index_this[lines[k]].append(k)
            i += n
            continue
        line = lines[i]
        out.append(b'\\' + line if line[:1] in (b'=', b'\\') else line)
        index_this[line].append(i)
        i += 1
    result = b''.join(line + b'\n' for line in out)
    if expand(result, previous) != text:
        raise GoldenFormatError('compression does not round-trip')
    return result


def expand(text, previous):
    before = _split_lines(previous) if previous else []
    lines = []
    for line in _split_lines(text):
        if line.startswith(b'='):
            m = _COPY.match(line)
            if not m:
                raise GoldenFormatError('bad directive %r' % line[:80])
            sequence = before if m.group(1) == b'prev' else lines
            first, count = int(m.group(2)), int(m.group(3))
            if first + count > len(sequence):
                raise GoldenFormatError('%r is out of range' % line)
            lines.extend(sequence[first:first + count])
        elif line.startswith(b'\\'):
            lines.append(line[1:])
        else:
            lines.append(line)
    return b''.join(line + b'\n' for line in lines)


# MARK: - Golden files

class _Reader:
    def __init__(self, data, path):
        self.data = data
        self.pos = 0
        self.path = path

    def at_end(self):
        return self.pos >= len(self.data)

    def line(self):
        end = self.data.find(b'\n', self.pos)
        if end < 0:
            raise GoldenFormatError('%s: missing LF at byte %d' % (self.path, self.pos))
        line = self.data[self.pos:end]
        self.pos = end + 1
        return line

    def payload(self, n):
        if self.pos + n >= len(self.data) or self.data[self.pos + n] != 0x0A:
            raise GoldenFormatError('%s: payload of %d bytes at byte %d is not followed by LF' % (self.path, n, self.pos))
        payload = self.data[self.pos:self.pos + n]
        self.pos += n + 1
        return payload

    def counted(self, keyword):
        line = self.line()
        m = re.match(rb'^' + keyword + rb' (\d+)$', line)
        if not m:
            raise GoldenFormatError('%s: expected "%s N", found %r' % (self.path, keyword.decode(), line[:80]))
        return self.payload(int(m.group(1)))


def parse_golden(data, path='<golden>'):
    """[Case] with expanded plans and dumps."""
    if not data.startswith(MAGIC):
        raise GoldenFormatError('%s: not a WGSLGOLDEN 1 file' % path)
    r = _Reader(data, path)
    r.line()
    cases = []
    previous_plan = previous_dump = None
    while not r.at_end():
        line = r.line()
        if line.startswith(b'#'):
            continue
        if not line.startswith(b'case '):
            raise GoldenFormatError('%s: expected "case", found %r' % (path, line[:80]))
        case = Case(unquote(line[5:]))
        source = r.line()
        if source.startswith(b'source-file '):
            case.source_file = unquote(source[12:])
        else:
            m = re.match(rb'^source-inline (\d+)$', source)
            if not m:
                raise GoldenFormatError('%s: bad source line %r' % (path, source[:80]))
            case.source_inline = r.payload(int(m.group(1)))
        try:
            case.plan = expand(r.counted(b'plan'), previous_plan)
            case.dump = expand(r.counted(b'expect'), previous_dump)
        except GoldenFormatError as error:
            raise GoldenFormatError('%s: case %s: %s' % (path, case.name, error))
        if r.line() != b'endcase':
            raise GoldenFormatError('%s: case %s does not end with "endcase"' % (path, case.name))
        previous_plan, previous_dump = case.plan, case.dump
        cases.append(case)
    return cases


def serialize_golden(cases, source):
    out = [MAGIC, (HEADER_TEMPLATE % source).encode('utf-8')]
    previous_plan = previous_dump = None
    for case in cases:
        out.append(b'case ' + quote(case.name).encode('ascii') + b'\n')
        if case.source_file is not None:
            out.append(b'source-file ' + quote(case.source_file).encode('ascii') + b'\n')
        else:
            out.append(b'source-inline %d\n' % len(case.source_inline) + case.source_inline + b'\n')
        plan = compress(case.plan, previous_plan)
        expect = compress(case.dump, previous_dump, is_dump=True)
        out.append(b'plan %d\n' % len(plan) + plan + b'\n')
        out.append(b'expect %d\n' % len(expect) + expect + b'\n')
        out.append(b'endcase\n')
        previous_plan, previous_dump = case.plan, case.dump
    return b''.join(out)


# MARK: - Layers of a difference

_LINE_LAYERS = [
    (b'WGSLDUMP ', 'input'), (b'input ', 'input'), (b'config ', 'input'),
    (b'check ', 'check'), (b'error ', 'check'), (b'warning ', 'check'),
    (b'entrypoints count=', 'reflect'), (b'ep ', 'reflect'), (b'defaults ', 'reflect'), (b'io ', 'reflect'),
    (b'  stagein ', 'reflect'), (b'  vout ', 'reflect'), (b'  fin ', 'reflect'), (b'  fout ', 'reflect'),
    (b'  flags ', 'reflect'),
    (b'unit ', 'units.req'), (b'  req ', 'units.req'), (b'  no-entry-point', 'units.prepare'),
    (b'  prepare ', 'units.prepare'), (b'  epi ', 'units.epi'), (b'    spec ', 'units.spec'),
    (b'    layout.default ', 'units.layout'), (b'    bgl ', 'units.layout'), (b'      ent ', 'units.layout'),
    (b'  writeback ', 'units.wb'), (b'    wb ', 'units.wb'),
    (b'  generate ', 'units.generate'), (b'    const.out ', 'units.const'), (b'    const ', 'units.const'),
    (b'    generate', 'units.generate'), (b'    msl', 'units.msl'),
    (b'  end-prepare', 'units.prepare'), (b'  evaluate ', 'units.evaluate'),
]


def _items(dump):
    """Lines, with a BLOCK and its payload as one item."""
    items = []
    pos = 0
    while pos < len(dump):
        end = dump.find(b'\n', pos)
        if end < 0:
            items.append(dump[pos:])
            break
        m = _BLOCK_HEADER.match(dump[pos:end])
        stop = min(len(dump), end + 1 + int(m.group(1)) + 1) if m else end + 1
        items.append(dump[pos:stop])
        pos = stop
    return items


def changed_layers(old, new):
    a = _items(old)
    b = _items(new)
    layers = set()
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        if tag != 'equal':
            for item in a[i1:i2] + b[j1:j2]:
                layers.add(next((layer for prefix, layer in _LINE_LAYERS if item.startswith(prefix)), 'other'))
    return sorted(layers)


# MARK: - Record mode

def _runner_from_build(configuration):
    directory = subprocess.run([os.path.join(SCRIPT_DIR, 'webkit-build-directory'), '--' + configuration.lower(), '--executablePath'],
                               stdout=subprocess.PIPE, check=True, text=True).stdout.strip()
    return os.path.join(directory, 'TestWGSL')


def _base_plan(kind, config):
    plan = BASE_PLANS[kind]
    return plan % config.encode('ascii') if kind == 'golden-inline' else plan


def main():
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--runner', help='the test binary: TestWGSL, or the standalone wgsl-swift-tests runner (default: TestWGSL of '
                                         'the --debug/--release build)')
    configuration = parser.add_mutually_exclusive_group()
    configuration.add_argument('--debug', dest='configuration', action='store_const', const='Debug', default='Debug')
    configuration.add_argument('--release', dest='configuration', action='store_const', const='Release')
    parser.add_argument('--goldens', default=os.path.join(TESTS_DIR, 'goldens'), help='golden directory (default: %(default)s)')
    parser.add_argument('--shaders', default=os.path.join(TESTS_DIR, 'shaders'), help='shader directory (default: %(default)s)')
    parser.add_argument('--files', default=','.join(GOLDEN_FILES), help='golden files to update (default: %(default)s)')
    parser.add_argument('--add-corpus', nargs='+', default=[], metavar='WGSL', help='add these files to corpus.golden (plan golden-v1)')
    parser.add_argument('--add-inline', nargs='+', default=[], metavar='WGSL', help='add these files to inline.golden (plan golden-inline)')
    parser.add_argument('--inline-config', default='tests', choices=('tests', 'tests-nofeatures'),
                        help='configuration of the --add-inline cases (default: %(default)s)')
    parser.add_argument('--check', action='store_true', help='change nothing; exit 1 if a golden file would change')
    parser.add_argument('--diff', action='store_true', help='also print a unified diff of each changed dump')
    parser.add_argument('--keep-record-dir', action='store_true')
    args = parser.parse_args()

    files = [f for f in args.files.split(',') if f]
    for name in files:
        if name not in GOLDEN_FILES:
            parser.error('unknown golden file %s' % name)
    runner = args.runner or _runner_from_build(args.configuration)
    if not os.path.exists(runner):
        parser.error('no test binary at %s (build TestWGSL or pass --runner)' % runner)

    goldens = {}
    pending = {name: [] for name in files}
    dropped = {name: [] for name in files}
    for name in files:
        path = os.path.join(args.goldens, name + '.golden')
        with open(path, 'rb') as f:
            goldens[name] = parse_golden(f.read(), path)

    if 'shaders' in goldens:
        known = set(case.source_file for case in goldens['shaders'])
        kept = []
        for case in goldens['shaders']:
            if os.path.exists(os.path.join(args.shaders, case.source_file)):
                kept.append(case)
            else:
                dropped['shaders'].append(case.name)
        goldens['shaders'] = kept
        for shader in sorted(os.listdir(args.shaders)):
            if shader.endswith('.wgsl') and shader not in known:
                with open(os.path.join(args.shaders, shader), 'rb') as f:
                    pending['shaders'].append(Case(shader, source_inline=f.read(), plan=_base_plan('golden-v1', None), dump=PENDING_DUMP))
    for kind, golden, paths in (('golden-v1', 'corpus', args.add_corpus), ('golden-inline', 'inline', args.add_inline)):
        if paths and golden not in goldens:
            parser.error('--add-%s needs %s in --files' % (golden, golden))
        names = set(case.name for case in goldens.get(golden, []))
        for path in paths:
            name = 'added/' + os.path.basename(path)
            if name in names:
                parser.error('%s already has a case %s' % (golden, name))
            names.add(name)
            with open(path, 'rb') as f:
                pending[golden].append(Case(name, source_inline=f.read(), plan=_base_plan(kind, args.inline_config), dump=PENDING_DUMP))

    record = tempfile.mkdtemp(prefix='wgsl-goldens-')
    try:
        for name, entries in pending.items():
            if entries:
                with open(os.path.join(record, name + '.pending'), 'wb') as f:
                    f.write(serialize_golden(entries, 'pending'))
        env = dict(os.environ, WGSL_GOLDEN_RECORD_DIR=record, WGSL_GOLDEN_DIR=args.goldens, WGSL_GOLDEN_SHADERS_DIR=args.shaders)
        result = subprocess.run([runner, '--filter', 'WGSLGoldenTests'], env=env)
        if result.returncode:
            print('error: %s exited with status %d' % (runner, result.returncode), file=sys.stderr)
            return 2

        changed_files = []
        for name in files:
            directory = os.path.join(record, name)

            def recorded(case, suffix):
                path = os.path.join(directory, record_file_name(case.name) + suffix)
                if not os.path.exists(path):
                    return None
                with open(path, 'rb') as f:
                    return f.read()

            new_cases = []
            changes = ['  removed %s (its shader is gone)' % case_name for case_name in dropped[name]]
            for case in goldens[name]:
                dump = recorded(case, '.dump')
                if dump is None:
                    error = recorded(case, '.error')
                    print('error: %s: no dump recorded for %s%s' % (name, case.name, (': ' + error.decode('utf-8', 'replace')) if error else ''),
                          file=sys.stderr)
                    return 2
                derived = recorded(case, '.plan') if name in V1_FILES else None
                if derived is not None and derived != case.plan:
                    print('warning: %s: the Swift golden-v1 derivation of %s differs from its stored plan (kept)' % (name, case.name))
                if case.dump != dump:
                    changes.append('  changed %s: %s' % (case.name, ', '.join(changed_layers(case.dump, dump))))
                    if args.diff:
                        changes.extend('    ' + line for line in difflib.unified_diff(
                            case.dump.decode('utf-8', 'replace').splitlines(), dump.decode('utf-8', 'replace').splitlines(),
                            'golden', 'actual', lineterm=''))
                new_cases.append(Case(case.name, case.source_file, case.source_inline, case.plan, dump))
            for case in pending[name]:
                dump = recorded(case, '.dump')
                plan = recorded(case, '.plan')
                if dump is None or plan is None:
                    print('error: %s: nothing recorded for the new case %s' % (name, case.name), file=sys.stderr)
                    return 2
                source_file = case.name if name == 'shaders' else None
                new_cases.append(Case(case.name, source_file, None if source_file else case.source_inline, plan, dump))
                changes.append('  added %s' % case.name)
            new_cases.sort(key=name_order)
            if changes:
                changed_files.append(name)
                print('%s.golden: %d cases' % (name, len(new_cases)))
                for line in changes:
                    print(line)
                if not args.check:
                    path = os.path.join(args.goldens, name + '.golden')
                    with open(path + '.tmp', 'wb') as f:
                        f.write(serialize_golden(new_cases, 'Swift'))
                    os.replace(path + '.tmp', path)
            else:
                print('%s.golden: unchanged (%d cases)' % (name, len(new_cases)))
        if args.check and changed_files:
            return 1
        return 0
    finally:
        if args.keep_record_dir:
            print('record directory: %s' % record)
        else:
            shutil.rmtree(record, ignore_errors=True)


if __name__ == '__main__':
    sys.exit(main())
