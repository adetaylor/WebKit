case "cts/shader-execution/ab8860bba0e7"
source-inline 802

    
@group(0) @binding(0) var texture : texture_storage_3d<r32uint, write>;

fn getValue() -> vec3u {
  
  return textureDimensions(texture);
}


struct VOut {
  @builtin(position) pos: vec4f,
  @location(0) @interpolate(flat, either) ndx: u32,
  @location(1) @interpolate(flat, either) result: vec4<u32>,
};

    
// --------------------------- fragment stage shaders --------------------------------
@vertex fn vsFragment(
    @builtin(vertex_index) vertex_index : u32,
    @builtin(instance_index) instance_index : u32) -> VOut {
  let positions = array(vec2f(-1, 3), vec2f(3, -1), vec2f(-1, -1));
  return VOut(vec4f(positions[vertex_index], 0, 1), instance_index, vec4<u32>(0));
}

@fragment fn fsFragment(v: VOut) -> @location(0) vec4u {
  return bitcast<vec4u>(vec4<u32>(getValue(), 0));
}

  
