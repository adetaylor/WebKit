case "cts/shader-execution/9f7bd0e12aaf"
source-inline 514

@group(0) @binding(0) var tex : texture_storage_1d<r32uint, write>;

const numTexels = 4096;
const width = 4096;
const height = 1;
const depth = 1;


fn indexToCoord(id : u32) -> i32 {
  return i32(id);
}

@compute @workgroup_size(32)
fn main(@builtin(global_invocation_id) gid : vec3u) {
  var coords = indexToCoord(gid.x);
  if gid.x % 2 == 1 {
    if gid.x % 3 == 0 {
          coords = -coords;
        } else {
          coords = coords + numTexels;
        }
  }
  textureStore(tex, coords, vec4u(gid.x));
}
