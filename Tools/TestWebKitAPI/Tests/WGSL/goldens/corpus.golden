using __PackedType = typename __PackedTypeImpl<T>::Type;

template <typename T>
static T __wgslInsertBits(T e, T newBits, unsigned offset, unsigned count)
{
    constexpr unsigned w = 8 * static_cast<unsigned>(sizeof(make_scalar_t<T>));
    const unsigned o = min(offset, w);
    const unsigned c = min(count, w - o);
    return insert_bits(e, newBits, min(o, w - 1), c);
}


