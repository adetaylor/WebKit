struct PackedVec3 {
    union { T x; T r; };
    union { T y; T g; };
    union { T z; T b; };
    uint8_t __padding[sizeof(T)];
    
    PackedVec3() { }
    
    PackedVec3(packed_vec<T, 3> v) : x(v.x), y(v.y), z(v.z) { }
    
    operator vec<T, 3>() const thread { return vec<T, 3>(x, y, z); }
    operator vec<T, 3>() const device { return vec<T, 3>(x, y, z); }
    operator vec<T, 3>() const constant { return vec<T, 3>(x, y, z); }
    operator vec<T, 3>() const threadgroup { return vec<T, 3>(x, y, z); }
    operator packed_vec<T, 3>() const thread { return packed_vec<T, 3>(x, y, z); }
    operator packed_vec<T, 3>() const device { return packed_vec<T, 3>(x, y, z); }
    operator packed_vec<T, 3>() const constant { return packed_vec<T, 3>(x, y, z); }
    operator packed_vec<T, 3>() const threadgroup { return packed_vec<T, 3>(x, y, z); }
    
    T operator[](int i) const { return i ? i == 2 ? z : y : x; }
    T operator[](int i) const device { return i ? i == 2 ? z : y : x; }
    device T& operator[](int i) device { return i ? i == 2 ? z : y : x; }
    constant T& operator[](int i) constant { return i ? i == 2 ? z : y : x; }
    thread T& operator[](int i) thread { return i ? i == 2 ? z : y : x; }
    threadgroup T& operator[](int i) threadgroup { return i ? i == 2 ? z : y : x; }
};

