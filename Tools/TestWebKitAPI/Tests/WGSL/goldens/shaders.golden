template<typename T, typename U, typename V = conditional_t<is_scalar_v<U>, T, U>>
static V __wgslDiv(T lhs, U rhs)
{
    auto predicate = V(rhs) == V(0);
    if constexpr (is_signed_v<U>)
        predicate = predicate || (V(lhs) == V(numeric_limits<T>::lowest()) && V(rhs) == V(-1));
    return lhs / select(V(rhs), V(1), predicate);
}

